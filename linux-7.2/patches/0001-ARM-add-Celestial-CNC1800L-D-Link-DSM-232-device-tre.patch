+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/celestial,cnc1800l-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L timers
+
+maintainers:
+  - tsuji-riya <tsuji.riya@gmail.com>
+
+description:
+  The AHB timer is used as clock event device and the APB timer as free
+  running clock source.
+
+properties:
+  compatible:
+    enum:
+      - celestial,cnc1800l-ahb-timer
+      - celestial,cnc1800l-apb-timer
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+
+if:
+  properties:
+    compatible:
+      const: celestial,cnc1800l-ahb-timer
+then:
+  required:
+    - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    timer@80270000 {
+        compatible = "celestial,cnc1800l-ahb-timer";
+        reg = <0x80270000 0x100>;
+        interrupts = <4>;
+        clocks = <&timer_clk>;
+    };
