diff --git a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
new file mode 100644
index 000000000..3e6c2206d
--- /dev/null
+++ b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/dts-v1/;
+
+#include "cnc1800l.dtsi"
+
+/ {
+	model = "D-Link DSM-232 (A1)";
+	compatible = "dlink,dsm-232-a1", "celestial,cnc1800l";
+
+	chosen {
+		bootargs = "earlycon console=ttyS0,115200n8";
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * The vendor firmware reserves the top of the 256MB DRAM for the
+	 * framebuffer, video/audio buffers, ethernet, crypto and demux
+	 * (see mem_define.h, Tiga-Mini layout). Only the memory below
+	 * XPORT_REGION (0x08971000, rounded down to 1MB) is given to Linux.
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x08900000>;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/celestial/cnc1800l.dtsi b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
new file mode 100644
index 000000000..bb40cb96a
--- /dev/null
+++ b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Celestial (Cavium) CNC1800L SoC
+ *
+ * Register addresses and interrupt numbers are taken from the vendor
+ * 2.6.32 BSP (mach/cnc1800l.h, mach/irqs.h).
+ */
+
+/ {
+	compatible = "celestial,cnc1800l";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,arm1176jzf-s";
+			reg = <0>;
+		};
+	};
+
+	/* PCLK, drives the UARTs and the APB timer */
+	pclk: clock-pclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <47250000>;
+	};
+
+	/* Clock of the AHB timer block */
+	timer_clk: clock-timer {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <94500000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		intc: interrupt-controller@80140000 {
+			compatible = "snps,dw-apb-ictl";
+			reg = <0x80140000 0x1000>;
+			interrupt-controller;
+			#interrupt-cells = <1>;
+		};
+
+		ahb_timer: timer@80270000 {
+			compatible = "celestial,cnc1800l-ahb-timer";
+			reg = <0x80270000 0x100>;
+			interrupt-parent = <&intc>;
+			interrupts = <4>;
+			clocks = <&timer_clk>;
+		};
+
+		apb_timer: timer@801e2000 {
+			compatible = "celestial,cnc1800l-apb-timer";
+			reg = <0x801e2000 0x100>;
+			clocks = <&pclk>;
+		};
+
+		uart0: serial@801f1000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x801f1000 0x100>;
+			interrupt-parent = <&intc>;
+			interrupts = <12>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clocks = <&pclk>;
+			status = "disabled";
+		};
+
+		uart1: serial@801f2000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x801f2000 0x100>;
+			interrupt-parent = <&intc>;
+			interrupts = <13>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clocks = <&pclk>;
+			status = "disabled";
+		};
+	};
+};
