From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Sat, 21 Nov 2026 03:14:19 +0000
Subject: [PATCH 08/28] dt-bindings: gpio: Add Celestial CNC1800L GPIO
 controller

The CNC1800L GPIO block has 41 lines in two ports and level interrupts
on one SoC interrupt.

Signed-off-by: Tsuji Riya <tsuji.riya@gmail.com>
---
 .../gpio/celestial,cnc1800l-gpio.yaml         | 56 +++++++++++++++++++
 MAINTAINERS                                   |  2 +
 2 files changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml

diff --git a/Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml b/Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml
new file mode 100644
index 000000000..806c2c9bb
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/celestial,cnc1800l-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L GPIO controller
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+description:
+  41 GPIO lines (port A 0-31, port B 32-40) with level interrupts.
+
+properties:
+  compatible:
+    const: celestial,cnc1800l-gpio
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+  interrupt-controller: true
+
+  "#interrupt-cells":
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - gpio-controller
+  - "#gpio-cells"
+  - interrupt-controller
+  - "#interrupt-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    gpio@80260000 {
+        compatible = "celestial,cnc1800l-gpio";
+        reg = <0x80260000 0x100>;
+        interrupts = <6>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index f3e41cef1..2d18a814f 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2755,12 +2755,14 @@ F:	drivers/net/ethernet/cavium/thunder/
 
 
 
+
 ARM/CELESTIAL CNC1800L SOC SUPPORT
 M:	Tsuji Riya <tsuji.riya@gmail.com>
 L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
 S:	Maintained
 F:	Documentation/devicetree/bindings/arm/celestial.yaml
 F:	Documentation/devicetree/bindings/clock/celestial,cnc1800l-clk.yaml
+F:	Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml
 F:	Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml
 F:	arch/arm/mach-celestial/
 F:	drivers/clk/clk-cnc1800l.c
