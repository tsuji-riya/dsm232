index 91fb5b40a..d15d59a72 100644
--- a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
+++ b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
@@ -22,11 +22,11 @@ chosen {
 		stdout-path = "serial0:115200n8";
 
 		/*
-		 * Scan-out buffer set up by the vendor U-Boot "logo" command
-		 * (it clears 0x0c000000 and starts HDMI). Values for
-		 * "logo 16 2 ...": 1920x1080 progressive 60Hz (mode 7, the
-		 * vendor's "1080P", is 1080i), RGB565, 2 bytes/pixel.
-		 * Must match the mode in the boot script.
+		 * Scan-out buffer, 1920x1080p60 RGB565, set up by
+		 * mach-celestial/cnc1800l-display.c. With
+		 * cnc1800l_display.skip=1 the vendor U-Boot "logo 16 2 ..."
+		 * sets it up instead (mode 7, the vendor's "1080P", is 1080i)
+		 * and its mode must match these values.
 		 */
 		framebuffer@c000000 {
 			compatible = "simple-framebuffer";
