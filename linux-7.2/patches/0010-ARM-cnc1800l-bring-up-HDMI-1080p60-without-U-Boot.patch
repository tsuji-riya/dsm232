 arch/arm/mach-celestial/Makefile              |   2 +-
 arch/arm/mach-celestial/cnc1800l-display.c    | 293 ++++++++++++++++++
 arch/arm/mach-celestial/cnc1800l.c            |   4 +
 arch/arm/mach-celestial/common.h              |   7 +
 5 files changed, 310 insertions(+), 6 deletions(-)
 create mode 100644 arch/arm/mach-celestial/cnc1800l-display.c
 create mode 100644 arch/arm/mach-celestial/common.h

