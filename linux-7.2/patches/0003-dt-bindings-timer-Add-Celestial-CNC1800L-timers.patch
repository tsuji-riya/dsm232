From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Sat, 21 Nov 2026 03:14:18 +0000
Subject: [PATCH 03/28] dt-bindings: timer: Add Celestial CNC1800L timers

The CNC1800L has an AHB timer, used as clock event device, and an APB
timer, used as free running clock source.

Signed-off-by: Tsuji Riya <tsuji.riya@gmail.com>
---
 .../timer/celestial,cnc1800l-timer.yaml       | 53 +++++++++++++++++++
 MAINTAINERS                                   |  2 +
 2 files changed, 55 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml

diff --git a/Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml b/Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml
new file mode 100644
index 000000000..1300e3558
--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/celestial,cnc1800l-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L timers
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+description:
+  The AHB timer is used as clock event device and the APB timer as free
+  running clock source.
+
+properties:
+  compatible:
+    enum:
+      - celestial,cnc1800l-ahb-timer
+      - celestial,cnc1800l-apb-timer
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+
+if:
+  properties:
+    compatible:
+      const: celestial,cnc1800l-ahb-timer
+then:
+  required:
+    - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    timer@80270000 {
+        compatible = "celestial,cnc1800l-ahb-timer";
+        reg = <0x80270000 0x100>;
+        interrupts = <4>;
+        clocks = <&timer_clk>;
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 821dee0b9..ad4002b54 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2750,11 +2750,13 @@ L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
 S:	Maintained
 F:	drivers/net/ethernet/cavium/thunder/
 
+
 ARM/CELESTIAL CNC1800L SOC SUPPORT
 M:	Tsuji Riya <tsuji.riya@gmail.com>
 L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
 S:	Maintained
 F:	Documentation/devicetree/bindings/arm/celestial.yaml
+F:	Documentation/devicetree/bindings/timer/celestial,cnc1800l-timer.yaml
 
 ARM/CIRRUS LOGIC BK3 MACHINE SUPPORT
