+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Celestial (Cavium) CNC1800L display: output interface 0 and graphics
+ * layer 1 of the display feeder (DF), and the Silicon Image HDMI
+ * transmitter of the SoC with its DDC master.
+ *
+ * The transmitter sends the blank colour instead of the picture unless
+ * HDCP 1.x encryption is on, so the driver authenticates (no repeater
+ * part 2) and keeps the link up from a work that runs every second; the
+ * same work sees hotplug. Register offsets and programming sequences were
+ * worked out from the vendor firmware (its GPL kernel sources and a trace
+ * of its hdmi.bin in an emulator); no vendor code is reused. The CEC
+ * controller (Silicon Image CPI) is polled every 20ms.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/hdmi.h>
+#include <linux/i2c.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/workqueue.h>
+
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_print.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+#include <media/cec.h>
+
+/* DF; registers written between UPDATE = 1 and 0 take effect together */
+#define DF_UPDATE		0x000
+#define DF_GFX_CTRL		0x040
+#define  GFX_ENABLE		BIT(0)
+#define  GFX_RGB2YUV		BIT(6)
+#define DF_GFX_FORMAT		0x044
+#define  GFX_RGB565		0x02
+#define  GFX_ARGB8888		0x06
+#define  GFX_XRGB8888		0x07
+#define  GFX_ALPHA_VALID	BIT(4)
+#define DF_GFX_ALPHA		0x048
+#define DF_GFX_KEY_R		0x04c
+#define DF_GFX_KEY_B		0x050
+#define DF_GFX_KEY_G		0x054
+#define DF_GFX_ADDR		0x058
+#define DF_GFX_PITCH		0x05c
+#define DF_GFX_X		0x060
+#define DF_GFX_Y		0x064
+#define DF_OUT_CTRL		0x340
+#define  OUT_EN			BIT(0)
+#define  OUT_HD			BIT(2)
+#define  OUT_DOWN_MODE		BIT(10)
+#define  OUT_HSYNC_LOW		BIT(12)
+#define  OUT_VSYNC_LOW		BIT(13)
+#define  OUT_DITHER		BIT(14)
+#define DF_OUT_X		0x344	/* active << 16 | total */
+#define DF_OUT_Y		0x348
+#define DF_OUT_HSYNC		0x34c	/* back porch << 20 | width << 10 | front porch */
+#define DF_OUT_VSYNC		0x350	/* back porch << 16 | width << 8 | front porch */
+#define DF_OUT_LEVEL		0x354
+
+/* HDMI TX: system page (I2C 0x72) register r at 4r, AV page at 0x400 + 4r */
+#define SYS_SRST		0x05
+#define SYS_SYS_CTRL1		0x08
+#define SYS_SYS_STAT		0x09
+#define  SYS_STAT_HPD		BIT(1)
+#define SYS_HDCP_CTRL		0x0f
+#define  HDCP_ENC_EN		BIT(0)
+#define  HDCP_RI_READY		BIT(1)
+#define  HDCP_CP_RESETN		BIT(2)
+#define  HDCP_AN_STOP		BIT(3)
+#define  HDCP_RX_REPEATER	BIT(4)
+#define  HDCP_BKSV_ERROR	BIT(5)
+#define  HDCP_ENC_ON		BIT(6)
+#define SYS_HDCP_BKSV		0x10	/* 5 bytes */
+#define SYS_HDCP_AN		0x15	/* 8 bytes */
+#define SYS_HDCP_AKSV		0x1d	/* 5 bytes */
+#define SYS_HDCP_RI		0x22	/* 2 bytes */
+#define SYS_DE_CTRL		0x33
+#define SYS_VID_CTRL		0x48
+#define SYS_VID_ACEN		0x49
+#define SYS_VID_MODE		0x4a
+#define SYS_VID_BLANK1		0x4b	/* 3 bytes */
+#define SYS_TMDS_CTRL		0x82
+/* DDC master: slave, segment, offset, count LSB, count MSB */
+#define SYS_DDC_ADDR		0xed
+#define SYS_DDC_STATUS		0xf2
+#define  DDC_IN_PROGRESS	BIT(4)
+#define  DDC_NO_ACK		BIT(5)
+#define SYS_DDC_CMD		0xf3
+#define  DDC_CMD_CUR_RD		0x00
+#define  DDC_CMD_SEQ_RD		0x02
+#define  DDC_CMD_ENH_RD		0x04
+#define  DDC_CMD_SEQ_WR		0x06
+#define  DDC_CMD_CLEAR_FIFO	0x09
+#define  DDC_CMD_ABORT		0x0f
+#define SYS_DDC_DATA		0xf4
+#define SYS_DDC_FIFO_CNT	0xf5
+#define DDC_FIFO_SIZE		16
+#define AV_PAGE			0x100
+#define AV_HDMI_CTRL		(AV_PAGE + 0x2f)
+#define AV_PB_CTRL1		(AV_PAGE + 0x3e)
+#define AV_PB_CTRL2		(AV_PAGE + 0x3f)
+#define AV_AVI_TYPE		(AV_PAGE + 0x40)
+#define AV_CP_BYTE1		(AV_PAGE + 0xdf)
+
+#define DDC_SEGMENT_ADDR	0x30
+
+/* CEC (CPI) registers, one byte per word from +0x1000 of the transmitter */
+#define CEC_BASE		0x1000
+#define CEC_DEBUG_3		0x21c
+#define  CEC_FLUSH_TX		BIT(7)
+#define CEC_TX_INIT		0x220	/* source logical address */
+#define CEC_TX_DEST		0x224
+#define  CEC_SEND_POLL		BIT(7)
+#define CEC_TX_COMMAND		0x23c
+#define CEC_TX_OPERAND		0x240
+#define CEC_TRANSMIT_DATA		0x27c
+#define  CEC_TRANSMIT_CMD	BIT(4)
+#define CEC_CAPTURE_ID0		0x288	/* logical addresses to acknowledge */
+#define CEC_CAPTURE_ID1		0x28c
+#define CEC_INT_STATUS0		0x298
+#define  CEC_TX_SENT		BIT(5)
+#define CEC_INT_STATUS1		0x29c
+#define  CEC_TX_RETRY_OV	BIT(1)
+#define CEC_RX_CONTROL		0x2b0
+#define  CEC_RX_CLR_CUR		BIT(0)
+#define  CEC_RX_CLR_ALL		BIT(1)
+#define CEC_RX_COUNT		0x2b4	/* frames << 4 | operands */
+#define  CEC_RX_ERROR		BIT(7)
+#define CEC_RX_HEADER		0x2b8
+#define CEC_RX_OPCODE		0x2bc
+#define CEC_RX_OPERAND		0x2c0
+#define CEC_OP_ABORT_31		0x37c
+
+/* HDCP receiver on DDC */
+#define HDCP_RX			0x3a
+#define  RX_BKSV		0x00
+#define  RX_RI			0x08
+#define  RX_AKSV		0x10
+#define  RX_AN			0x18
+#define  RX_BCAPS		0x40
+#define   BCAPS_REPEATER	BIT(6)
+
+struct cnc_drm {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector conn;
+	struct i2c_adapter ddc;
+	void __iomem *df, *hdmi;
+	struct clk *disp_clk, *tmds_clk, *cec_clk;
+	struct reset_control *disp_rst, *hdmi_rst;
+	struct delayed_work work;
+	struct mutex lock;		/* transmitter state, against the work */
+	u8 avi[HDMI_INFOFRAME_SIZE(AVI)];
+	bool is_hdmi, edid_ok, enabled, hpd, hdcp_on, replug;
+	unsigned int fails, polls, bad;
+	struct cec_adapter *cec;
+	struct delayed_work cec_work;
+	u16 cec_las;			/* claimed logical addresses */
+	unsigned int cec_tx_wait;	/* polls left for the frame in flight */
+};
+
+#define to_cnc(d) container_of(d, struct cnc_drm, drm)
+
+static void tx_wr(struct cnc_drm *p, unsigned int reg, u8 val)
+{
+	writel(val, p->hdmi + reg * 4);
+}
+
+static u8 tx_rd(struct cnc_drm *p, unsigned int reg)
+{
+	return readl(p->hdmi + reg * 4);
+}
+
+/* one DDC master command; data of a write goes through the FIFO first */
+static int ddc_run(struct cnc_drm *p, u8 addr, u8 seg, u8 off, u8 cmd, u8 *buf, u16 len)
+{
+	bool rd = cmd != DDC_CMD_SEQ_WR;
+	int i = 0, tries = len + 50;
+
+	if (!rd && len > DDC_FIFO_SIZE)
+		return -EOPNOTSUPP;
+	tx_wr(p, SYS_DDC_CMD, DDC_CMD_CLEAR_FIFO);
+	tx_wr(p, SYS_DDC_ADDR, addr << 1);
+	tx_wr(p, SYS_DDC_ADDR + 1, seg);
+	tx_wr(p, SYS_DDC_ADDR + 2, off);
+	tx_wr(p, SYS_DDC_ADDR + 3, len);
+	tx_wr(p, SYS_DDC_ADDR + 4, len >> 8);
+	for (i = 0; !rd && i < len; i++)
+		tx_wr(p, SYS_DDC_DATA, buf[i]);
+	tx_wr(p, SYS_DDC_CMD, cmd);
+
+	if (rd) {
+		for (i = 0; i < len && tries; ) {
+			if (tx_rd(p, SYS_DDC_FIFO_CNT)) {
+				buf[i++] = tx_rd(p, SYS_DDC_DATA);
+			} else {
+				tries--;
+				usleep_range(1000, 2000);
+			}
+		}
+	} else {
+		while ((tx_rd(p, SYS_DDC_STATUS) & DDC_IN_PROGRESS) && --tries)
+			usleep_range(1000, 2000);
+	}
+	if (tries && !(tx_rd(p, SYS_DDC_STATUS) & DDC_NO_ACK))
+		return 0;
+	tx_wr(p, SYS_DDC_CMD, DDC_CMD_ABORT);
+	return -EIO;
+}
+
+/*
+ * The DDC master does whole transactions: [segment write to 0x30], offset
+ * write, then a read or more written bytes. That covers EDID and HDCP.
+ */
+static int ddc_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num)
+{
+	struct cnc_drm *p = i2c_get_adapdata(adap);
+	struct i2c_msg *m = msgs;
+	u8 seg = 0, cmd = DDC_CMD_SEQ_RD;
+	int total = num, ret;
+
+	if (num == 3 && m->addr == DDC_SEGMENT_ADDR && m->len == 1 && !(m->flags & I2C_M_RD)) {
+		seg = m->buf[0];
+		cmd = DDC_CMD_ENH_RD;
+		m++;
+		num--;
+	}
+	if (num == 1 && (m->flags & I2C_M_RD))
+		ret = ddc_run(p, m->addr, 0, 0, DDC_CMD_CUR_RD, m->buf, m->len);
+	else if (num == 1 && m->len)
+		ret = ddc_run(p, m->addr, 0, m->buf[0], DDC_CMD_SEQ_WR, m->buf + 1, m->len - 1);
+	else if (num == 2 && m->len == 1 && !(m->flags & I2C_M_RD) &&
+		 (m[1].flags & I2C_M_RD) && m[1].addr == m->addr)
+		ret = ddc_run(p, m->addr, seg, m->buf[0], cmd, m[1].buf, m[1].len);
+	else
+		return -EOPNOTSUPP;
+
+	return ret ?: total;
+}
+
+static u32 ddc_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C;
+}
+
+static const struct i2c_algorithm ddc_algo = {
+	.xfer		= ddc_xfer,
+	.functionality	= ddc_func,
+};
+
+static int hdcp_rx_read(struct cnc_drm *p, u8 off, u8 *buf, u16 len)
+{
+	struct i2c_msg msgs[] = {
+		{ .addr = HDCP_RX, .len = 1, .buf = &off },
+		{ .addr = HDCP_RX, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+
+	return i2c_transfer(&p->ddc, msgs, 2) == 2 ? 0 : -EIO;
+}
+
+static int hdcp_rx_write(struct cnc_drm *p, u8 off, const u8 *buf, u16 len)
+{
+	u8 data[DDC_FIFO_SIZE + 1] = { off };
+	struct i2c_msg msg = { .addr = HDCP_RX, .len = len + 1, .buf = data };
+
+	memcpy(data + 1, buf, len);
+	return i2c_transfer(&p->ddc, &msg, 1) == 1 ? 0 : -EIO;
+}
+
+/* general control packet: AVMUTE set or cleared, sent every frame */
+static void hdmi_avmute(struct cnc_drm *p, bool mute)
+{
+	u8 ctrl = tx_rd(p, AV_PB_CTRL2) & ~0x0c;
+
+	if (!p->is_hdmi)
+		return;
+	tx_wr(p, AV_PB_CTRL2, ctrl);
+	tx_wr(p, AV_CP_BYTE1, mute ? 0x01 : 0x10);
+	msleep(50);	/* vendor: without it, AV mute/unmute causes snow on the TV */
+	tx_wr(p, AV_PB_CTRL2, ctrl | 0x0c);
+}
+
+/* register writes of hdmi.bin, mode independent apart from the AVI InfoFrame */
+static void hdmi_setup(struct cnc_drm *p)
+{
+	unsigned int i;
+
+	/*
+	 * SYS_CTRL1: PD# (0), EDGE (1), BSEL (2), HEN/VEN (4/5, take HSYNC and
+	 * VSYNC from the DF); 0x37 is what hdmi.bin leaves on hardware.
+	 */
+	tx_wr(p, SYS_SYS_CTRL1, 0x31);
+	tx_wr(p, SYS_VID_BLANK1, p->is_hdmi ? 0x80 : 0);	/* black, YCbCr or RGB */
+	tx_wr(p, SYS_VID_BLANK1 + 1, p->is_hdmi ? 0x10 : 0);
+	tx_wr(p, SYS_VID_BLANK1 + 2, p->is_hdmi ? 0x80 : 0);
+	tx_wr(p, SYS_TMDS_CTRL, 0x25);
+	tx_wr(p, AV_HDMI_CTRL, p->is_hdmi);
+	tx_wr(p, SYS_DE_CTRL, 0x00);
+	tx_wr(p, SYS_VID_MODE, 0x00);
+	tx_wr(p, SYS_SYS_CTRL1, 0x35);
+	tx_wr(p, SYS_VID_CTRL, 0x00);
+	tx_wr(p, SYS_VID_ACEN, 0x40);
+	tx_wr(p, SYS_SYS_CTRL1, 0x37);
+	tx_wr(p, SYS_SRST, 0x03);		/* software and FIFO reset */
+	tx_wr(p, SYS_SRST, 0x00);
+	tx_wr(p, SYS_HDCP_CTRL, 0x00);
+
+	tx_wr(p, AV_PB_CTRL1, 0x00);
+	tx_wr(p, AV_PB_CTRL2, 0x00);
+	if (!p->is_hdmi)
+		return;
+	for (i = 0; i < sizeof(p->avi); i++)
+		tx_wr(p, AV_AVI_TYPE + i, p->avi[i]);
+	tx_wr(p, AV_PB_CTRL1, 0x03);		/* AVI on, every frame */
+	tx_wr(p, AV_CP_BYTE1, 0x10);		/* general control packet: clear AVMUTE */
+	tx_wr(p, AV_PB_CTRL2, 0x0c);
+}
+
+/* HDCP 1.x authentication, first part; the transmitter holds the keys */
+static int hdcp_auth(struct cnc_drm *p)
+{
+	u8 bksv[5], an[8], aksv[5], ri_rx[2], bcaps, ctrl;
+	int i, ones = 0;
+
+	if (hdcp_rx_read(p, RX_BKSV, bksv, 5))
+		return -EIO;
+	for (i = 0; i < 5; i++)
+		ones += hweight8(bksv[i]);
+	if (ones != 20)		/* a KSV has 20 ones and 20 zeros */
+		return -ENXIO;
+
+	ctrl = (tx_rd(p, SYS_HDCP_CTRL) & ~HDCP_ENC_EN) | HDCP_CP_RESETN;
+	tx_wr(p, SYS_HDCP_CTRL, ctrl);
+	if (hdcp_rx_read(p, RX_BCAPS, &bcaps, 1))
+		return -EIO;
+	if (bcaps & BCAPS_REPEATER)
+		ctrl |= HDCP_RX_REPEATER;
+	else
+		ctrl &= ~HDCP_RX_REPEATER;
+	/* GenerateAN(): run the random number generator for a while */
+	tx_wr(p, SYS_HDCP_CTRL, ctrl & ~HDCP_AN_STOP);
+	msleep(20);
+	tx_wr(p, SYS_HDCP_CTRL, ctrl | HDCP_AN_STOP);
+
+	for (i = 0; i < 8; i++)
+		an[i] = tx_rd(p, SYS_HDCP_AN + i);
+	if (hdcp_rx_write(p, RX_AN, an, 8))
+		return -EIO;
+	for (i = 0; i < 5; i++)
+		aksv[i] = tx_rd(p, SYS_HDCP_AKSV + i);
+	if (hdcp_rx_write(p, RX_AKSV, aksv, 5))
+		return -EIO;
+	msleep(150);	/* vendor delay before R0 */
+
+	/* writing BKSV into the transmitter starts its R0 calculation */
+	for (i = 0; i < 5; i++)
+		tx_wr(p, SYS_HDCP_BKSV + i, bksv[i]);
+	if (tx_rd(p, SYS_HDCP_CTRL) & HDCP_BKSV_ERROR)
+		return -EINVAL;
+	for (i = 0; i < 100 && !(tx_rd(p, SYS_HDCP_CTRL) & HDCP_RI_READY); i++)
+		usleep_range(5000, 10000);
+	if (hdcp_rx_read(p, RX_RI, ri_rx, 2))
+		return -EIO;
+	if (ri_rx[0] != tx_rd(p, SYS_HDCP_RI) || ri_rx[1] != tx_rd(p, SYS_HDCP_RI + 1))
+		return -EACCES;
+
+	tx_wr(p, SYS_HDCP_CTRL, tx_rd(p, SYS_HDCP_CTRL) | HDCP_ENC_EN);
+	return 0;
+}
+
+/* Ri, which the receiver updates every 128 frames: read ours around its value */
+static bool hdcp_link_ok(struct cnc_drm *p)
+{
+	u8 rx[2], tx[4];
+
+	if (!(tx_rd(p, SYS_HDCP_CTRL) & HDCP_ENC_ON))
+		return false;
+	tx[0] = tx_rd(p, SYS_HDCP_RI);
+	tx[1] = tx_rd(p, SYS_HDCP_RI + 1);
+	if (hdcp_rx_read(p, RX_RI, rx, 2))
+		return false;
+	tx[2] = tx_rd(p, SYS_HDCP_RI);
+	tx[3] = tx_rd(p, SYS_HDCP_RI + 1);
+	return (rx[0] == tx[0] && rx[1] == tx[1]) || (rx[0] == tx[2] && rx[1] == tx[3]);
+}
+
+/*
+ * Every second: hotplug from the HPD level (the HPD change interrupt bit is
+ * set again by the set-up itself), HDCP authentication until it works (the
+ * receiver does not answer on DDC for a while after the link comes up), and
+ * Ri compared every 2s, since a TV switching inputs drops HDCP without an
+ * HPD change. A re-plug or a lost link sets up the transmitter again.
+ */
+static void cnc_work(struct work_struct *work)
+{
+	struct cnc_drm *p = container_of(to_delayed_work(work), struct cnc_drm, work);
+	bool hpd, changed;
+	int ret;
+
+	mutex_lock(&p->lock);
+	hpd = tx_rd(p, SYS_SYS_STAT) & SYS_STAT_HPD;
+	changed = hpd != p->hpd;
+	p->hpd = hpd;
+	if (!hpd) {
+		if (changed)
+			cec_phys_addr_invalidate(p->cec);
+		p->hdcp_on = false;
+		p->replug = true;
+		goto out;
+	}
+	if (!p->enabled)
+		goto out;
+	if (p->hdcp_on && !p->replug) {
+		if (++p->polls % 2 || hdcp_link_ok(p)) {
+			p->bad = 0;
+			goto out;
+		}
+		if (++p->bad < 2)	/* one failed DDC read is no lost link */
+			goto out;
+	}
+	if (p->hdcp_on || p->replug) {
+		drm_dbg_kms(&p->drm, "HDMI %s, setting up again\n",
+			    p->replug ? "plugged" : "link lost");
+		p->hdcp_on = false;
+		p->replug = false;
+		p->fails = 0;
+		p->bad = 0;
+		hdmi_setup(p);
+	}
+
+	hdmi_avmute(p, true);	/* encryption changes under AVMUTE */
+	ret = hdcp_auth(p);
+	hdmi_avmute(p, false);
+	if (!ret) {
+		drm_info(&p->drm, "HDCP authenticated (try %u)\n", p->fails + 1);
+		p->hdcp_on = true;
+	} else if (++p->fails == 30) {
+		drm_warn(&p->drm, "HDCP still failing (%d), the picture stays blank\n", ret);
+	}
+out:
+	mutex_unlock(&p->lock);
+	if (changed)
+		drm_kms_helper_hotplug_event(&p->drm);
+	schedule_delayed_work(&p->work, HZ);
+}
+
+static u8 cec_rd(struct cnc_drm *p, unsigned int reg)
+{
+	return readl(p->hdmi + CEC_BASE + reg);
+}
+
+static void cec_wr(struct cnc_drm *p, unsigned int reg, u8 val)
+{
+	writel(val, p->hdmi + CEC_BASE + reg);
+}
+
+/* ack the interrupt status, finish a transmit, drain the receive FIFO */
+static void cnc_cec_work(struct work_struct *work)
+{
+	struct cnc_drm *p = container_of(to_delayed_work(work), struct cnc_drm, cec_work);
+	u8 s0 = cec_rd(p, CEC_INT_STATUS0), s1 = cec_rd(p, CEC_INT_STATUS1);
+	struct cec_msg msg = {};
+	unsigned int i, cnt;
+
+	if (s1 & CEC_TX_RETRY_OV)	/* or the frame is sent again once cleared */
+		cec_wr(p, CEC_DEBUG_3, cec_rd(p, CEC_DEBUG_3) | CEC_FLUSH_TX);
+	cec_wr(p, CEC_INT_STATUS0, s0);
+	cec_wr(p, CEC_INT_STATUS1, s1);
+	if (p->cec_tx_wait) {
+		if (s0 & CEC_TX_SENT) {
+			p->cec_tx_wait = 0;
+			cec_transmit_attempt_done(p->cec, CEC_TX_STATUS_OK);
+		} else if (s1 & CEC_TX_RETRY_OV) {
+			p->cec_tx_wait = 0;
+			cec_transmit_attempt_done(p->cec, CEC_TX_STATUS_NACK);
+		} else if (!--p->cec_tx_wait) {
+			cec_transmit_attempt_done(p->cec, CEC_TX_STATUS_ERROR);
+		}
+	}
+
+	while (cec_rd(p, CEC_RX_COUNT) >> 4) {
+		cnt = cec_rd(p, CEC_RX_COUNT);
+		if (!(cnt & CEC_RX_ERROR)) {
+			msg.len = 2 + (cnt & 0x0f);
+			msg.msg[0] = cec_rd(p, CEC_RX_HEADER);
+			msg.msg[1] = cec_rd(p, CEC_RX_OPCODE);
+			for (i = 2; i < msg.len; i++)
+				msg.msg[i] = cec_rd(p, CEC_RX_OPERAND + (i - 2) * 4);
+			cec_received_msg(p->cec, &msg);
+		}
+		cec_wr(p, CEC_RX_CONTROL, CEC_RX_CLR_CUR);
+	}
+	schedule_delayed_work(&p->cec_work, msecs_to_jiffies(20));
+}
+
+static int cnc_cec_enable(struct cec_adapter *adap, bool enable)
+{
+	struct cnc_drm *p = cec_get_drvdata(adap);
+	int ret;
+
+	if (!enable) {
+		cancel_delayed_work_sync(&p->cec_work);
+		cec_wr(p, CEC_CAPTURE_ID0, 0);
+		cec_wr(p, CEC_CAPTURE_ID1, 0);
+		clk_disable_unprepare(p->cec_clk);
+		return 0;
+	}
+	/* the registers hang the bus with the CEC clock off */
+	ret = clk_prepare_enable(p->cec_clk);
+	if (ret)
+		return ret;
+	p->cec_las = 0;
+	p->cec_tx_wait = 0;
+	cec_wr(p, CEC_OP_ABORT_31, 0);	/* no automatic <Feature Abort>, the core answers */
+	cec_wr(p, CEC_CAPTURE_ID0, 0);
+	cec_wr(p, CEC_CAPTURE_ID1, 0);
+	cec_wr(p, CEC_RX_CONTROL, CEC_RX_CLR_ALL);
+	cec_wr(p, CEC_INT_STATUS0, 0xff);
+	cec_wr(p, CEC_INT_STATUS1, 0xff);
+	schedule_delayed_work(&p->cec_work, 0);
+	return 0;
+}
+
+static int cnc_cec_log_addr(struct cec_adapter *adap, u8 la)
+{
+	struct cnc_drm *p = cec_get_drvdata(adap);
+
+	if (la == CEC_LOG_ADDR_INVALID)
+		p->cec_las = 0;
+	else
+		p->cec_las |= BIT(la);
+	cec_wr(p, CEC_CAPTURE_ID0, p->cec_las);
+	cec_wr(p, CEC_CAPTURE_ID1, p->cec_las >> 8);
+	return 0;
+}
+
+static int cnc_cec_transmit(struct cec_adapter *adap, u8 attempts, u32 signal_free_time,
+			    struct cec_msg *msg)
+{
+	struct cnc_drm *p = cec_get_drvdata(adap);
+	u8 dest = cec_msg_destination(msg);
+	unsigned int i;
+
+	cec_wr(p, CEC_DEBUG_3, cec_rd(p, CEC_DEBUG_3) | CEC_FLUSH_TX);
+	cec_wr(p, CEC_INT_STATUS0, 0x64);	/* buffer full, sent, FIFO empty */
+	cec_wr(p, CEC_INT_STATUS1, CEC_TX_RETRY_OV);
+	cec_wr(p, CEC_TX_INIT, cec_msg_initiator(msg));
+	p->cec_tx_wait = 100;			/* 2s */
+	if (msg->len == 1) {
+		cec_wr(p, CEC_TX_DEST, CEC_SEND_POLL | dest);
+		return 0;
+	}
+	cec_wr(p, CEC_TX_DEST, dest);
+	cec_wr(p, CEC_TX_COMMAND, msg->msg[1]);
+	for (i = 2; i < msg->len; i++)
+		cec_wr(p, CEC_TX_OPERAND + (i - 2) * 4, msg->msg[i]);
+	cec_wr(p, CEC_TRANSMIT_DATA, CEC_TRANSMIT_CMD | (msg->len - 2));
+	return 0;
+}
+
+static const struct cec_adap_ops cnc_cec_ops = {
+	.adap_enable	= cnc_cec_enable,
+	.adap_log_addr	= cnc_cec_log_addr,
+	.adap_transmit	= cnc_cec_transmit,
+};
