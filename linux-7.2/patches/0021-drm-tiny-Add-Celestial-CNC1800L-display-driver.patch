+static int cnc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct drm_device *drm;
+	struct cnc_drm *p;
+	int ret;
+
+	p = devm_drm_dev_alloc(dev, &cnc_driver, struct cnc_drm, drm);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	drm = &p->drm;
+
+	p->df = devm_platform_ioremap_resource_byname(pdev, "df");
+	if (IS_ERR(p->df))
+		return PTR_ERR(p->df);
+	p->hdmi = devm_platform_ioremap_resource_byname(pdev, "hdmi");
+	if (IS_ERR(p->hdmi))
+		return PTR_ERR(p->hdmi);
+	p->disp_clk = devm_clk_get(dev, "disp");
+	if (IS_ERR(p->disp_clk))
+		return PTR_ERR(p->disp_clk);
+	/* on all the time: HPD and DDC are read with no picture too */
+	p->tmds_clk = devm_clk_get_enabled(dev, "tmds");
+	if (IS_ERR(p->tmds_clk))
+		return PTR_ERR(p->tmds_clk);
+	p->cec_clk = devm_clk_get(dev, "cec");
+	if (IS_ERR(p->cec_clk))
+		return PTR_ERR(p->cec_clk);
+	p->disp_rst = devm_reset_control_get_exclusive(dev, "disp");
+	if (IS_ERR(p->disp_rst))
+		return PTR_ERR(p->disp_rst);
+	p->hdmi_rst = devm_reset_control_get_exclusive(dev, "hdmi");
+	if (IS_ERR(p->hdmi_rst))
+		return PTR_ERR(p->hdmi_rst);
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ret = devm_mutex_init(dev, &p->lock);
+	if (ret)
+		return ret;
+
+	p->ddc.owner = THIS_MODULE;
+	p->ddc.algo = &ddc_algo;
+	p->ddc.dev.parent = dev;
+	strscpy(p->ddc.name, "cnc1800l-ddc", sizeof(p->ddc.name));
+	i2c_set_adapdata(&p->ddc, p);
+	ret = devm_i2c_add_adapter(dev, &p->ddc);
+	if (ret)
+		return ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+	drm->mode_config.max_width = 1920;
+	drm->mode_config.max_height = 1080;
+	drm->mode_config.funcs = &cnc_mode_config_funcs;
+
+	drm_connector_helper_add(&p->conn, &cnc_conn_helper_funcs);
+	ret = drm_connector_init_with_ddc(drm, &p->conn, &cnc_conn_funcs,
+					  DRM_MODE_CONNECTOR_HDMIA, &p->ddc);
+	if (ret)
+		return ret;
+	p->conn.polled = DRM_CONNECTOR_POLL_HPD;
+	ret = drm_simple_display_pipe_init(drm, &p->pipe, &cnc_pipe_funcs, cnc_formats,
+					   ARRAY_SIZE(cnc_formats), NULL, &p->conn);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(drm);
+
+	INIT_DELAYED_WORK(&p->cec_work, cnc_cec_work);
+	p->cec = cec_allocate_adapter(&cnc_cec_ops, p, "cnc1800l",
+				      CEC_CAP_DEFAULTS | CEC_CAP_CONNECTOR_INFO, 1);
+	ret = PTR_ERR_OR_ZERO(p->cec);
+	if (ret)
+		return ret;
+	cec_fill_conn_info_from_drm(&p->cec->conn_info, &p->conn);
+	ret = cec_register_adapter(p->cec, dev);
+	if (ret) {
+		cec_delete_adapter(p->cec);
+		return ret;
+	}
+	ret = devm_add_action_or_reset(dev, cnc_cec_unregister, p->cec);
+	if (ret)
+		return ret;
+
+	INIT_DELAYED_WORK(&p->work, cnc_work);
+	ret = devm_add_action_or_reset(dev, cnc_stop_work, &p->work);
+	if (ret)
+		return ret;
+	p->hpd = tx_rd(p, SYS_SYS_STAT) & SYS_STAT_HPD;
+	schedule_delayed_work(&p->work, HZ);
+
+	platform_set_drvdata(pdev, drm);
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+	drm_client_setup_with_fourcc(drm, DRM_FORMAT_RGB565);
+	return 0;
+}
+
+static void cnc_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(drm);
+	drm_atomic_helper_shutdown(drm);
+}
