+static const u32 cnc_formats[] = {
+	DRM_FORMAT_RGB565,
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static enum drm_mode_status cnc_mode_valid(struct drm_simple_display_pipe *pipe,
+					   const struct drm_display_mode *mode)
+{
+	struct cnc_drm *p = container_of(pipe, struct cnc_drm, pipe);
+	long rate = mode->clock * 1000L;
+
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+	if (mode->clock > 148500)
+		return MODE_CLOCK_HIGH;
+	/* +-0.5% allowed by HDMI */
+	if (abs_diff(clk_round_rate(p->disp_clk, rate), rate) > rate / 200)
+		return MODE_NOCLOCK;
+	return MODE_OK;
+}
+
+static void cnc_update(struct drm_simple_display_pipe *pipe, struct drm_plane_state *old)
+{
+	struct cnc_drm *p = container_of(pipe, struct cnc_drm, pipe);
+	struct drm_plane_state *state = pipe->plane.state;
+	struct drm_framebuffer *fb = state->fb;
+	u32 fmt;
+
+	if (!fb)
+		return;
+	switch (fb->format->format) {
+	case DRM_FORMAT_ARGB8888:
+		fmt = GFX_ARGB8888 | GFX_ALPHA_VALID;
+		break;
+	case DRM_FORMAT_XRGB8888:
+		fmt = GFX_XRGB8888;
+		break;
+	default:
+		fmt = GFX_RGB565 | GFX_ALPHA_VALID;	/* as the vendor leaves it */
+		break;
+	}
+	writel(1, p->df + DF_UPDATE);
+	writel(fmt, p->df + DF_GFX_FORMAT);
+	writel(drm_fb_dma_get_gem_addr(fb, state, 0), p->df + DF_GFX_ADDR);
+	writel(fb->pitches[0], p->df + DF_GFX_PITCH);
+	writel(0, p->df + DF_UPDATE);
+}
+
+static void cnc_enable(struct drm_simple_display_pipe *pipe, struct drm_crtc_state *cstate,
+		       struct drm_plane_state *pstate)
+{
+	struct cnc_drm *p = container_of(pipe, struct cnc_drm, pipe);
+	const struct drm_display_mode *m = &cstate->adjusted_mode;
+	struct drm_connector *conn = &p->conn;
+	struct hdmi_avi_infoframe avi;
+	bool hd = m->vdisplay >= 720;
+	/* without an EDID (DDC failed) assume HDMI, which every TV here was */
+	bool is_hdmi = conn->display_info.is_hdmi || !p->edid_ok;
+	u32 ctrl;
+
+	/* clock_dispset_clockmoderaw(): display held in reset while the PLL changes */
+	reset_control_assert(p->disp_rst);
+	clk_set_rate(p->disp_clk, m->clock * 1000);
+	clk_set_rate(p->tmds_clk, m->clock * 1000);
+	reset_control_deassert(p->disp_rst);
+	clk_prepare_enable(p->disp_clk);
+
+	ctrl = OUT_EN | OUT_DOWN_MODE | OUT_DITHER | (hd ? OUT_HD : 0) |
+	       (m->flags & DRM_MODE_FLAG_PHSYNC ? 0 : OUT_HSYNC_LOW) |
+	       (m->flags & DRM_MODE_FLAG_PVSYNC ? 0 : OUT_VSYNC_LOW);
+	writel(1, p->df + DF_UPDATE);
+	writel(ctrl, p->df + DF_OUT_CTRL);
+	writel(m->hdisplay << 16 | m->htotal, p->df + DF_OUT_X);
+	writel(m->vdisplay << 16 | m->vtotal, p->df + DF_OUT_Y);
+	writel((m->htotal - m->hsync_end) << 20 | (m->hsync_end - m->hsync_start) << 10 |
+	       (m->hsync_start - m->hdisplay), p->df + DF_OUT_HSYNC);
+	writel((m->vtotal - m->vsync_end) << 16 | (m->vsync_end - m->vsync_start) << 8 |
+	       (m->vsync_start - m->vdisplay), p->df + DF_OUT_VSYNC);
+	writel(800 << 16 | 252, p->df + DF_OUT_LEVEL);	/* VGA white, black */
+	/* graphics layer 1 over the whole picture; the vendor end line is not inclusive */
+	writel(0x3ff, p->df + DF_GFX_ALPHA);
+	writel((m->hdisplay - 1) << 16, p->df + DF_GFX_X);
+	writel(m->vdisplay << 16, p->df + DF_GFX_Y);
+	writel(GFX_ENABLE | (is_hdmi ? GFX_RGB2YUV : 0), p->df + DF_GFX_CTRL);
+	writel(0, p->df + DF_UPDATE);
+	cnc_update(pipe, NULL);
+
+	/*
+	 * HDMI sinks get YCbCr 4:4:4 (what the DF sends with RGB2YUV),
+	 * underscan, IT content; DVI sinks RGB without InfoFrames.
+	 */
+	mutex_lock(&p->lock);
+	p->is_hdmi = is_hdmi;
+	drm_hdmi_avi_infoframe_from_display_mode(&avi, conn, m);
+	avi.colorspace = HDMI_COLORSPACE_YUV444;
+	avi.colorimetry = hd ? HDMI_COLORIMETRY_ITU_709 : HDMI_COLORIMETRY_ITU_601;
+	avi.scan_mode = HDMI_SCAN_MODE_UNDERSCAN;
+	avi.active_aspect = HDMI_ACTIVE_ASPECT_PICTURE;
+	avi.itc = true;
+	hdmi_avi_infoframe_pack(&avi, p->avi, sizeof(p->avi));
+	/* clock_hdmi_reset() pulse, which hdmi.bin does first; its length is a guess */
+	reset_control_assert(p->hdmi_rst);
+	usleep_range(10, 20);
+	reset_control_deassert(p->hdmi_rst);
+	hdmi_setup(p);
+	p->enabled = true;
+	p->hdcp_on = false;
+	p->replug = false;
+	p->fails = 0;
+	p->bad = 0;
+	mutex_unlock(&p->lock);
+	mod_delayed_work(system_wq, &p->work, HZ / 2);
+}
+
+static void cnc_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct cnc_drm *p = container_of(pipe, struct cnc_drm, pipe);
+
+	mutex_lock(&p->lock);
+	p->enabled = false;
+	tx_wr(p, SYS_HDCP_CTRL, 0);
+	mutex_unlock(&p->lock);
+	writel(1, p->df + DF_UPDATE);
+	writel(0, p->df + DF_GFX_CTRL);
+	writel(0, p->df + DF_OUT_CTRL);
+	writel(0, p->df + DF_UPDATE);
+	clk_disable_unprepare(p->disp_clk);
+}
