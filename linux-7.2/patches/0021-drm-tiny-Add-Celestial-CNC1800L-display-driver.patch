+static int cnc_conn_get_modes(struct drm_connector *conn)
+{
+	struct cnc_drm *p = to_cnc(conn->dev);
+	const struct drm_edid *edid = drm_edid_read_ddc(conn, &p->ddc);
+	int n;
+
+	p->edid_ok = edid;
+	drm_edid_connector_update(conn, edid);
+	cec_s_phys_addr(p->cec, conn->display_info.source_physical_address, false);
+	n = drm_edid_connector_add_modes(conn);
+	drm_edid_free(edid);
+	if (!n) {
+		n = drm_add_modes_noedid(conn, 1920, 1080);
+		drm_set_preferred_mode(conn, 1920, 1080);
+	}
+	return n;
+}
+
+static int cnc_conn_detect(struct drm_connector *conn, struct drm_modeset_acquire_ctx *ctx,
+			   bool force)
+{
+	struct cnc_drm *p = to_cnc(conn->dev);
+
+	return tx_rd(p, SYS_SYS_STAT) & SYS_STAT_HPD ?
+	       connector_status_connected : connector_status_disconnected;
+}
+
+static const struct drm_connector_helper_funcs cnc_conn_helper_funcs = {
+	.get_modes	= cnc_conn_get_modes,
+	.detect_ctx	= cnc_conn_detect,
+};
