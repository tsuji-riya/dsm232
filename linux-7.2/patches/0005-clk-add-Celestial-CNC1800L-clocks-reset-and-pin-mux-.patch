 arch/arm/boot/dts/celestial/cnc1800l.dtsi     |  37 ++++
 arch/arm/configs/cnc1800l_defconfig           |   4 +
 drivers/clk/Kconfig                           |   8 +
 drivers/clk/Makefile                          |   1 +
 drivers/clk/clk-cnc1800l.c                    | 198 ++++++++++++++++++
 .../clock/celestial,cnc1800l-clk.h            |  15 ++
 7 files changed, 312 insertions(+)
