 create mode 100644 drivers/clk/clk-cnc1800l.c
 create mode 100644 include/dt-bindings/clock/celestial,cnc1800l-clk.h

diff --git a/Documentation/devicetree/bindings/clock/celestial,cnc1800l-clk.yaml b/Documentation/devicetree/bindings/clock/celestial,cnc1800l-clk.yaml
new file mode 100644
index 000000000..17a8c8664
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/celestial,cnc1800l-clk.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/celestial,cnc1800l-clk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L clock controller
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+description:
+  The display PLL with the display and HDMI TMDS dividers and the clock
+  enables of the clock block. Its reset register (at +0x200) is a
+  separate snps,dw-low-reset controller. Clock numbers are in
+  include/dt-bindings/clock/celestial,cnc1800l-clk.h.
+
+properties:
+  compatible:
+    const: celestial,cnc1800l-clk
+
+  reg:
+    items:
+      - description: PLL, divider and clock enable registers
+      - description: PLL sleep and USB PHY bypass registers
+
+  clocks:
+    items:
+      - description: 27MHz oscillator
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@b2100000 {
+        compatible = "celestial,cnc1800l-clk";
+        reg = <0xb2100000 0x200>, <0xb210020c 0x10>;
+        clocks = <&osc27m>;
+        #clock-cells = <1>;
+    };
diff --git a/arch/arm/boot/dts/celestial/cnc1800l.dtsi b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
index b710f3297..c564bbfaf 100644
--- a/arch/arm/boot/dts/celestial/cnc1800l.dtsi
+++ b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
@@ -6,6 +6,8 @@
  * 2.6.32 BSP (mach/cnc1800l.h, mach/irqs.h).
  */
 
+#include <dt-bindings/clock/celestial,cnc1800l-clk.h>
+
 / {
 	compatible = "celestial,cnc1800l";
 	#address-cells = <1>;
@@ -27,6 +29,12 @@ cpu@0 {
 		};
 	};
 
+	osc27m: clock-osc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <27000000>;
+	};
+
 	/* PCLK, drives the UARTs and the APB timer */
 	pclk: clock-pclk {
 		compatible = "fixed-clock";
@@ -61,6 +69,35 @@ intc: interrupt-controller@80140000 {
 			#interrupt-cells = <1>;
 		};
 
+		/* the reset bits at +0x200 are a reset controller of their own */
+		clk: clock-controller@b2100000 {
+			compatible = "celestial,cnc1800l-clk";
+			reg = <0xb2100000 0x200>, <0xb210020c 0x10>;
+			clocks = <&osc27m>;
+			#clock-cells = <1>;
+		};
+
+		/* active low, vendor clock_*_reset() */
+		rst: reset-controller@b2100200 {
+			compatible = "snps,dw-low-reset";
+			reg = <0xb2100200 0x4>;
+			#reset-cells = <1>;
+		};
+
+		/* one bit (or field) per function, 16 bit accesses as the vendor cnc1800l_mux.c */
+		pinmux: pinmux@b2110000 {
+			compatible = "pinctrl-single";
+			reg = <0xb2110000 0x30>;
+			#pinctrl-cells = <2>;
+			pinctrl-single,bit-per-mux;
+			pinctrl-single,register-width = <16>;
+			pinctrl-single,function-mask = <0x1>;
+
+			sdio_pins: sdio-pins {
+				pinctrl-single,bits = <0x24 0x1 0x1>;
+			};
+		};
+
 		ahb_timer: timer@80270000 {
 			compatible = "celestial,cnc1800l-ahb-timer";
 			reg = <0x80270000 0x100>;
