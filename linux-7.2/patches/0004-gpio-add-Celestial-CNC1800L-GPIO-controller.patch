 arch/arm/boot/dts/celestial/cnc1800l.dtsi     |  11 +
 arch/arm/configs/cnc1800l_defconfig           |   1 +
 drivers/gpio/Kconfig                          |  10 +
 drivers/gpio/Makefile                         |   1 +
 drivers/gpio/gpio-cnc1800l.c                  | 248 ++++++++++++++++++
 6 files changed, 327 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpio/celestial,cnc1800l-gpio.yaml
