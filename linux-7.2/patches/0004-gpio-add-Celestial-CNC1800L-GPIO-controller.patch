index 000000000..1b08ca072
--- /dev/null
+++ b/drivers/gpio/gpio-cnc1800l.c
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Celestial (Cavium) CNC1800L GPIO controller
+ *
+ * GPIO 0-31 are port A, 32-40 port B. The direction register has 1 for
+ * input. Interrupts are level only, so edges are emulated by waiting for
+ * the opposite level after each one. Register layout of the vendor
+ * cnc18xx_gpio.c.
+ */
+
+#include <linux/bitops.h>
+#include <linux/gpio/driver.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#define CNC_NGPIO	41
+
+struct cnc_gpio_port {
+	u8 dr, ddr, mask, pol, ext, stat;
+};
+
+static const struct cnc_gpio_port cnc_ports[] = {
+	{ .dr = 0x20, .ddr = 0x24, .mask = 0x28, .pol = 0x2c, .ext = 0x60, .stat = 0x68 },
+	{ .dr = 0x34, .ddr = 0x38, .mask = 0x3c, .pol = 0x40, .ext = 0x64, .stat = 0x6c },
+};
+
+struct cnc_gpio {
+	struct gpio_chip gc;
+	void __iomem *base;
+	raw_spinlock_t lock;
+	u32 rising[2], falling[2];	/* emulated edge interrupts */
+};
+
+#define PORT(off)	(&cnc_ports[(off) / 32])
+#define BIT_OF(off)	BIT((off) % 32)
+
+static void cnc_gpio_rmw(struct cnc_gpio *g, u8 reg, u32 bit, bool set)
+{
+	unsigned long flags;
+	u32 val;
+
+	raw_spin_lock_irqsave(&g->lock, flags);
+	val = readl(g->base + reg);
+	writel(set ? val | bit : val & ~bit, g->base + reg);
+	raw_spin_unlock_irqrestore(&g->lock, flags);
+}
+
+static int cnc_gpio_get(struct gpio_chip *gc, unsigned int off)
+{
+	struct cnc_gpio *g = gpiochip_get_data(gc);
+
+	return !!(readl(g->base + PORT(off)->ext) & BIT_OF(off));
+}
+
+static int cnc_gpio_set(struct gpio_chip *gc, unsigned int off, int val)
+{
+	cnc_gpio_rmw(gpiochip_get_data(gc), PORT(off)->dr, BIT_OF(off), val);
+	return 0;
+}
+
+static int cnc_gpio_get_direction(struct gpio_chip *gc, unsigned int off)
+{
+	struct cnc_gpio *g = gpiochip_get_data(gc);
+
+	return readl(g->base + PORT(off)->ddr) & BIT_OF(off) ?
+	       GPIO_LINE_DIRECTION_IN : GPIO_LINE_DIRECTION_OUT;
+}
+
+static int cnc_gpio_direction_input(struct gpio_chip *gc, unsigned int off)
+{
+	cnc_gpio_rmw(gpiochip_get_data(gc), PORT(off)->ddr, BIT_OF(off), true);
+	return 0;
+}
+
+static int cnc_gpio_direction_output(struct gpio_chip *gc, unsigned int off, int val)
+{
+	struct cnc_gpio *g = gpiochip_get_data(gc);
+
+	cnc_gpio_rmw(g, PORT(off)->dr, BIT_OF(off), val);
+	cnc_gpio_rmw(g, PORT(off)->ddr, BIT_OF(off), false);
+	return 0;
+}
+
+static void cnc_gpio_irq_mask(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	irq_hw_number_t off = irqd_to_hwirq(d);
+
+	cnc_gpio_rmw(gpiochip_get_data(gc), PORT(off)->mask, BIT_OF(off), true);
+	gpiochip_disable_irq(gc, off);
+}
+
+static void cnc_gpio_irq_unmask(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	irq_hw_number_t off = irqd_to_hwirq(d);
+
+	gpiochip_enable_irq(gc, off);
+	cnc_gpio_rmw(gpiochip_get_data(gc), PORT(off)->mask, BIT_OF(off), false);
+}
+
+/* wait for the level that is not there now: the next edge */
+static void cnc_gpio_arm_edge(struct cnc_gpio *g, unsigned int off)
+{
+	/* polarity 1 = interrupt while low (vendor: "the document is wrong") */
+	cnc_gpio_rmw(g, PORT(off)->pol, BIT_OF(off), cnc_gpio_get(&g->gc, off));
+}
+
+static int cnc_gpio_irq_set_type(struct irq_data *d, unsigned int type)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct cnc_gpio *g = gpiochip_get_data(gc);
+	irq_hw_number_t off = irqd_to_hwirq(d);
+	unsigned int p = off / 32;
+	u32 bit = BIT_OF(off);
+
+	g->rising[p] &= ~bit;
+	g->falling[p] &= ~bit;
+	switch (type & IRQ_TYPE_SENSE_MASK) {
+	case IRQ_TYPE_LEVEL_HIGH:
+	case IRQ_TYPE_LEVEL_LOW:
+		cnc_gpio_rmw(g, PORT(off)->pol, bit, type == IRQ_TYPE_LEVEL_LOW);
+		irq_set_handler_locked(d, handle_level_irq);
+		return 0;
+	case IRQ_TYPE_EDGE_BOTH:
+		g->rising[p] |= bit;
+		g->falling[p] |= bit;
+		break;
+	case IRQ_TYPE_EDGE_RISING:
+		g->rising[p] |= bit;
+		break;
+	case IRQ_TYPE_EDGE_FALLING:
+		g->falling[p] |= bit;
+		break;
+	default:
+		return -EINVAL;
+	}
+	cnc_gpio_arm_edge(g, off);
+	irq_set_handler_locked(d, handle_simple_irq);
+	return 0;
+}
+
+static void cnc_gpio_irq_handler(struct irq_desc *desc)
+{
+	struct gpio_chip *gc = irq_desc_get_handler_data(desc);
+	struct cnc_gpio *g = gpiochip_get_data(gc);
+	struct irq_chip *chip = irq_desc_get_chip(desc);
+	unsigned long pending;
+	unsigned int p, bit;
+
+	chained_irq_enter(chip, desc);
+	for (p = 0; p < ARRAY_SIZE(cnc_ports); p++) {
+		pending = readl(g->base + cnc_ports[p].stat) &
+			  ~readl(g->base + cnc_ports[p].mask);
+		for_each_set_bit(bit, &pending, 32) {
+			unsigned int off = p * 32 + bit;
+			u32 edges = g->rising[p] | g->falling[p];
+
+			if (edges & BIT(bit)) {
+				int level = cnc_gpio_get(gc, off);
+
+				cnc_gpio_arm_edge(g, off);
+				if (!((level ? g->rising[p] : g->falling[p]) & BIT(bit)))
+					continue;
+			}
+			generic_handle_domain_irq(gc->irq.domain, off);
+		}
+	}
+	chained_irq_exit(chip, desc);
+}
+
+static const struct irq_chip cnc_gpio_irq_chip = {
+	.name		= "cnc1800l-gpio",
+	.irq_mask	= cnc_gpio_irq_mask,
+	.irq_unmask	= cnc_gpio_irq_unmask,
+	.irq_set_type	= cnc_gpio_irq_set_type,
+	.flags		= IRQCHIP_IMMUTABLE,
+	GPIOCHIP_IRQ_RESOURCE_HELPERS,
+};
+
+static int cnc_gpio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct gpio_irq_chip *girq;
+	struct cnc_gpio *g;
+	unsigned int p;
+	int irq;
+
+	g = devm_kzalloc(dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+
+	g->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(g->base))
+		return PTR_ERR(g->base);
+	raw_spin_lock_init(&g->lock);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	for (p = 0; p < ARRAY_SIZE(cnc_ports); p++)
+		writel(~0, g->base + cnc_ports[p].mask);
+
+	g->gc.label = dev_name(dev);
+	g->gc.parent = dev;
+	g->gc.owner = THIS_MODULE;
+	g->gc.base = -1;
+	g->gc.ngpio = CNC_NGPIO;
+	g->gc.get = cnc_gpio_get;
+	g->gc.set = cnc_gpio_set;
+	g->gc.get_direction = cnc_gpio_get_direction;
+	g->gc.direction_input = cnc_gpio_direction_input;
+	g->gc.direction_output = cnc_gpio_direction_output;
+
+	girq = &g->gc.irq;
+	gpio_irq_chip_set_chip(girq, &cnc_gpio_irq_chip);
+	girq->parent_handler = cnc_gpio_irq_handler;
+	girq->num_parents = 1;
+	girq->parents = devm_kcalloc(dev, 1, sizeof(*girq->parents), GFP_KERNEL);
+	if (!girq->parents)
+		return -ENOMEM;
+	girq->parents[0] = irq;
+	girq->default_type = IRQ_TYPE_NONE;
+	girq->handler = handle_bad_irq;
+
+	return devm_gpiochip_add_data(dev, &g->gc, g);
+}
+
+static const struct of_device_id cnc_gpio_of_match[] = {
+	{ .compatible = "celestial,cnc1800l-gpio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cnc_gpio_of_match);
+
+static struct platform_driver cnc_gpio_driver = {
+	.probe	= cnc_gpio_probe,
+	.driver	= {
+		.name		= "cnc1800l-gpio",
+		.of_match_table	= cnc_gpio_of_match,
+	},
+};
+builtin_platform_driver(cnc_gpio_driver);
