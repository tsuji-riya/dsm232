diff --git a/include/dt-bindings/clock/celestial,cnc1800l-clk.h b/include/dt-bindings/clock/celestial,cnc1800l-clk.h
new file mode 100644
index 000000000..abbeb0606
--- /dev/null
+++ b/include/dt-bindings/clock/celestial,cnc1800l-clk.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause */
+#ifndef _DT_BINDINGS_CLOCK_CELESTIAL_CNC1800L_H
+#define _DT_BINDINGS_CLOCK_CELESTIAL_CNC1800L_H
+
+#define CNC1800L_CLK_TVE_PLL	0
+#define CNC1800L_CLK_DISP0	1
+#define CNC1800L_CLK_HDMI_TMDS	2
+#define CNC1800L_CLK_AUDIO	3
+#define CNC1800L_CLK_CEC	4
+#define CNC1800L_CLK_USB_PHY	5
+#define CNC1800L_CLK_USB	6
+
+#define CNC1800L_NR_CLKS	7
+
+#endif
