+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mtd/celestial,cnc1800l-nand.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial CNC1800L NAND controller
+
+maintainers:
+  - tsuji-riya <tsuji.riya@gmail.com>
+
+description: |
+  NAND controller of the Celestial (Cavium) CNC1800L SoC. The default ECC
+  is the SoC 1-bit Hamming engine (3 bytes per 512 bytes), which matches
+  the vendor firmware on-flash format. Generic software ECC can be selected
+  with the standard nand-ecc-* properties of the NAND chip child node
+  (not compatible with existing vendor formatted flash).
+
+allOf:
+  - $ref: nand-controller.yaml
+
+properties:
+  compatible:
+    const: celestial,cnc1800l-nand
+
+  reg:
+    items:
+      - description: NAND access window.
+      - description: Controller registers.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    nand-controller@a4000000 {
+        compatible = "celestial,cnc1800l-nand";
+        reg = <0xa4000000 0x2000000>, <0x80100000 0x48>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        nand@0 {
+            reg = <0>;
+            nand-on-flash-bbt;
+        };
+    };
