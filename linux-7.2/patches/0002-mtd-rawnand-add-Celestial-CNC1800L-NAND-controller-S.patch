+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * DSM-232 with the generic (software BCH) NAND ECC instead of the SoC
+ * 1-bit Hamming engine.
+ *
+ * WARNING: the on-flash format is NOT compatible with the vendor firmware,
+ * the miniloader and the vendor U-Boot. Use it only when the whole NAND is
+ * reformatted and nothing in NAND is read by the boot ROM / miniloader.
+ */
+#include "cnc1800l-dsm232.dts"
+
+/ {
+	model = "D-Link DSM-232 (A1), generic NAND ECC";
+};
+
+&nand {
+	nand@0 {
+		nand-ecc-mode = "soft";
+		nand-ecc-algo = "bch";
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+	};
+};
diff --git a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
index 3e6c2206d..582769993 100644
--- a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
+++ b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
@@ -27,3 +27,54 @@ memory@0 {
 &uart0 {
 	status = "okay";
 };
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+		m25p,fast-read;
+	};
+};
+
+&nand {
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		nand-on-flash-bbt;
+
+		/*
+		 * LEGACY ECC (default): SoC 1-bit Hamming / 512 bytes, the
+		 * vendor on-flash format. Required for every partition that
+		 * the miniloader / vendor boot loaders read, and keeps
+		 * existing flash contents readable.
+		 */
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* layout from the vendor bootargs of the DSM-232 */
+			partition@0 {
+				label = "kernel";
+				reg = <0x00000000 0x00300000>;
+			};
+			partition@300000 {
+				label = "fs";
+				reg = <0x00300000 0x1f800000>;
+			};
+			partition@1fb00000 {
+				label = "kernel_update";
+				reg = <0x1fb00000 0x00300000>;
+			};
+			partition@1fe00000 {
+				label = "bad_blks_table";
+				reg = <0x1fe00000 0x00200000>;
+			};
+		};
+	};
+};
