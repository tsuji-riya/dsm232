diff --git a/drivers/mtd/nand/raw/cnc1800l_nand.c b/drivers/mtd/nand/raw/cnc1800l_nand.c
new file mode 100644
index 000000000..ea6d9264a
--- /dev/null
+++ b/drivers/mtd/nand/raw/cnc1800l_nand.c
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * NAND controller driver for the Celestial (Cavium) CNC1800L SoC
+ *
+ * The controller exposes the NAND bus through a memory window: data cycles
+ * go to the window base, command and address cycles to base + CLE / ALE
+ * offsets. Chip enable is forced from CEn_CFG_0 and ready/busy is read from
+ * the status register.
+ *
+ * Two ECC schemes are supported, selected with the standard NAND DT
+ * properties of the chip node:
+ *
+ *  - on-host (default, "legacy"): the SoC 1-bit Hamming engine, one 3 byte
+ *    code per 512 byte step. The on-flash format is the one used by the
+ *    vendor firmware and boot loaders, so existing NAND contents and the
+ *    miniloader keep working.
+ *  - soft ("nand-ecc-mode = "soft"" or "nand-ecc-engine" absent with
+ *    "nand-ecc-algo"): the generic MTD software ECC (Hamming or BCH),
+ *    which is NOT compatible with the vendor format.
+ *
+ * Based on the vendor 2.6.32 driver by Xiaodong Fan and on davinci_nand.c.
+ */
+
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/partitions.h>
+#include <linux/mtd/rawnand.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#define CNC_CE_CFG0(cs)		((cs) * 0x0c)
+#define CNC_CE_FORCE_LOW	BIT(9)
+#define CNC_STATUS		0x30
+#define CNC_STATUS_READY	BIT(0)
+#define CNC_MODE		0x38
+#define CNC_ECC_CODE		0x40
+#define CNC_ECC_CNT		0x44
+#define CNC_ECC_ADDR		0x48
+
+#define CNC_MASK_ALE		0x08
+#define CNC_MASK_CLE		0x04
+#define CNC_CS_STRIDE		BIT(26)	/* address window stride per chip select */
+#define CNC_MAX_CS		4
+
+struct cnc_nand {
+	struct nand_controller	controller;
+	struct nand_chip	chip;
+	struct device		*dev;
+
+	void __iomem		*base;	/* control registers */
+	void __iomem		*vaddr;	/* data window */
+	phys_addr_t		paddr;	/* physical address of the data window */
+
+	void __iomem		*current_cs;
+	phys_addr_t		current_paddr;
+	u32			ce_forced;	/* bitmask of forced-low chip enables */
+};
+
+static inline struct cnc_nand *to_cnc_nand(struct nand_chip *chip)
+{
+	return container_of(chip, struct cnc_nand, chip);
+}
+
+/*
+ * Legacy on-host ECC: 1-bit Hamming over 512 bytes.
+ *
+ * The engine snoops the data window access whose physical address is
+ * programmed into ECC_ADDR.
+ */
+static void cnc_nand_hwctl(struct nand_chip *chip, int mode)
+{
+	struct cnc_nand *nand = to_cnc_nand(chip);
+
+	writel(nand->current_paddr, nand->base + CNC_ECC_ADDR);
+}
+
+static int cnc_nand_calculate(struct nand_chip *chip, const u8 *dat,
+			      u8 *ecc_code)
+{
+	struct cnc_nand *nand = to_cnc_nand(chip);
+	u32 ecc24 = readl(nand->base + CNC_ECC_CODE);
+
+	ecc_code[0] = ecc24;
+	ecc_code[1] = ecc24 >> 8;
+	ecc_code[2] = ecc24 >> 16;
+
+	return 0;
+}
+
+static int cnc_nand_correct(struct nand_chip *chip, u8 *dat, u8 *read_ecc,
+			    u8 *calc_ecc)
+{
+	u32 ecc_nand = read_ecc[0] | (read_ecc[1] << 8) | (read_ecc[2] << 16);
+	u32 ecc_calc = calc_ecc[0] | (calc_ecc[1] << 8) | (calc_ecc[2] << 16);
+	u32 diff = ecc_calc ^ ecc_nand;
+	unsigned int bit, byte;
+
+	if (!diff)
+		return 0;
+
+	/* Single bit error in the data: every pair of code bits differs */
+	if ((((diff >> 1) ^ diff) & 0x555555) == 0x555555) {
+		bit = ((diff >> 19) & 1) | ((diff >> 20) & 2) |
+		      ((diff >> 21) & 4);
+		byte = ((diff >> 9) & 0x100) | (diff & 0x80) |
+		       ((diff << 1) & 0x40) | ((diff << 2) & 0x20) |
+		       ((diff << 3) & 0x10) | ((diff >> 12) & 0x08) |
+		       ((diff >> 11) & 0x04) | ((diff >> 10) & 0x02) |
+		       ((diff >> 9) & 0x01);
+
+		if (byte >= chip->ecc.size)
+			return -EBADMSG;
+
+		dat[byte] ^= BIT(bit);
+		return 1;
+	}
+
+	/* Single bit error in the ECC code itself, data is fine */
+	if (!(diff & (diff - 1)))
+		return 1;
+
+	return -EBADMSG;
+}
+
+static int cnc_nand_attach_chip(struct nand_chip *chip)
+{
+	struct cnc_nand *nand = to_cnc_nand(chip);
+	struct mtd_info *mtd = nand_to_mtd(chip);
+
+	chip->ecc.options |= NAND_ECC_GENERIC_ERASED_CHECK;
+
+	switch (chip->ecc.engine_type) {
+	case NAND_ECC_ENGINE_TYPE_NONE:
+		break;
+	case NAND_ECC_ENGINE_TYPE_SOFT:
+		if (chip->ecc.algo == NAND_ECC_ALGO_UNKNOWN)
+			chip->ecc.algo = NAND_ECC_ALGO_HAMMING;
+		break;
+	case NAND_ECC_ENGINE_TYPE_INVALID:
+	case NAND_ECC_ENGINE_TYPE_ON_HOST:
+		chip->ecc.engine_type = NAND_ECC_ENGINE_TYPE_ON_HOST;
+		chip->ecc.algo = NAND_ECC_ALGO_HAMMING;
+		chip->ecc.size = 512;
+		chip->ecc.bytes = 3;
+		chip->ecc.strength = 1;
+		chip->ecc.calculate = cnc_nand_calculate;
+		chip->ecc.correct = cnc_nand_correct;
+		chip->ecc.hwctl = cnc_nand_hwctl;
+		/* default small/large page Hamming OOB layouts: same as vendor */
+		break;
+	default:
+		dev_err(nand->dev, "unsupported ECC engine type\n");
+		return -EINVAL;
+	}
+
+	dev_info(nand->dev, "ECC: %s, page %u OOB %u\n",
+		 chip->ecc.engine_type == NAND_ECC_ENGINE_TYPE_ON_HOST ?
+		 "legacy on-host 1-bit/512" :
+		 chip->ecc.engine_type == NAND_ECC_ENGINE_TYPE_SOFT ?
+		 "soft" : "none", mtd->writesize, mtd->oobsize);
+
+	return 0;
+}
+
+static void cnc_nand_ce(struct cnc_nand *nand, unsigned int cs)
+{
+	u32 val;
+
+	if (nand->ce_forced & BIT(cs))
+		return;
+
+	val = readl(nand->base + CNC_CE_CFG0(cs));
+	writel(val | CNC_CE_FORCE_LOW, nand->base + CNC_CE_CFG0(cs));
+	nand->ce_forced |= BIT(cs);
+}
+
+static void cnc_nand_data_in(struct cnc_nand *nand, void *buf,
+			     unsigned int len)
+{
+	ioread8_rep(nand->current_cs, buf, len);
+}
+
+static void cnc_nand_data_out(struct cnc_nand *nand, const void *buf,
+			      unsigned int len)
+{
+	iowrite8_rep(nand->current_cs, buf, len);
+}
+
+static int cnc_nand_exec_instr(struct cnc_nand *nand,
+			       const struct nand_op_instr *instr)
+{
+	unsigned int i;
+	u32 status;
+	int ret;
+
+	switch (instr->type) {
+	case NAND_OP_CMD_INSTR:
+		iowrite8(instr->ctx.cmd.opcode, nand->current_cs + CNC_MASK_CLE);
+		break;
+	case NAND_OP_ADDR_INSTR:
+		for (i = 0; i < instr->ctx.addr.naddrs; i++)
+			iowrite8(instr->ctx.addr.addrs[i],
+				 nand->current_cs + CNC_MASK_ALE);
+		break;
+	case NAND_OP_DATA_IN_INSTR:
+		cnc_nand_data_in(nand, instr->ctx.data.buf.in,
+				 instr->ctx.data.len);
+		break;
+	case NAND_OP_DATA_OUT_INSTR:
+		cnc_nand_data_out(nand, instr->ctx.data.buf.out,
+				  instr->ctx.data.len);
+		break;
+	case NAND_OP_WAITRDY_INSTR:
+		ret = readl_relaxed_poll_timeout(nand->base + CNC_STATUS, status,
+						 status & CNC_STATUS_READY, 5,
+						 instr->ctx.waitrdy.timeout_ms * 1000);
+		if (ret)
+			return ret;
+		break;
+	}
+
+	if (instr->delay_ns) {
+		/* make sure the previous write reached the bus */
+		readl(nand->base + CNC_STATUS);
+		ndelay(instr->delay_ns);
+	}
+
+	return 0;
+}
+
+static int cnc_nand_exec_op(struct nand_chip *chip,
+			    const struct nand_operation *op, bool check_only)
+{
+	struct cnc_nand *nand = to_cnc_nand(chip);
+	unsigned int i;
+	int ret;
+
+	if (check_only)
+		return 0;
+
+	if (op->cs >= CNC_MAX_CS)
+		return -EINVAL;
+
+	nand->current_cs = nand->vaddr + op->cs * CNC_CS_STRIDE;
+	nand->current_paddr = nand->paddr + (phys_addr_t)op->cs * CNC_CS_STRIDE;
+	cnc_nand_ce(nand, op->cs);
+
+	for (i = 0; i < op->ninstrs; i++) {
+		ret = cnc_nand_exec_instr(nand, &op->instrs[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct nand_controller_ops cnc_nand_ops = {
+	.attach_chip = cnc_nand_attach_chip,
+	.exec_op = cnc_nand_exec_op,
+};
+
+static int cnc_nand_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct cnc_nand *nand;
+	struct mtd_info *mtd;
+	int ret;
+
+	nand = devm_kzalloc(dev, sizeof(*nand), GFP_KERNEL);
+	if (!nand)
+		return -ENOMEM;
+
+	nand->dev = dev;
+	nand->vaddr = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(nand->vaddr))
+		return PTR_ERR(nand->vaddr);
+	nand->paddr = res->start;
+
+	nand->base = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(nand->base))
+		return PTR_ERR(nand->base);
+
+	nand->current_cs = nand->vaddr;
+	nand->current_paddr = nand->paddr;
+
+	nand_controller_init(&nand->controller);
+	nand->controller.ops = &cnc_nand_ops;
+
+	nand->chip.controller = &nand->controller;
+	nand_set_flash_node(&nand->chip, dev->of_node);
+
+	mtd = nand_to_mtd(&nand->chip);
+	mtd->dev.parent = dev;
+	mtd->name = dev_name(dev);
+
+	platform_set_drvdata(pdev, nand);
+
+	ret = nand_scan(&nand->chip, 1);
+	if (ret)
+		return ret;
+
+	ret = mtd_device_register(mtd, NULL, 0);
+	if (ret)
+		nand_cleanup(&nand->chip);
+
+	return ret;
+}
+
+static void cnc_nand_remove(struct platform_device *pdev)
+{
+	struct cnc_nand *nand = platform_get_drvdata(pdev);
+	int ret;
+
+	ret = mtd_device_unregister(nand_to_mtd(&nand->chip));
+	WARN_ON(ret);
+	nand_cleanup(&nand->chip);
+}
+
+static const struct of_device_id cnc_nand_of_match[] = {
+	{ .compatible = "celestial,cnc1800l-nand" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cnc_nand_of_match);
+
+static struct platform_driver cnc_nand_driver = {
+	.probe	= cnc_nand_probe,
+	.remove	= cnc_nand_remove,
+	.driver	= {
+		.name		= "cnc1800l-nand",
+		.of_match_table	= cnc_nand_of_match,
+	},
+};
+module_platform_driver(cnc_nand_driver);
