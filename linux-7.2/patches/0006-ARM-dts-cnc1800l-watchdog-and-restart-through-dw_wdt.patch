From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Fri, 20 Nov 2026 01:21:14 +0000
Subject: [PATCH 06/13] ARM: dts: cnc1800l: watchdog and restart through dw_wdt

Reboot hung with "Reboot failed -- System halted": nothing could reset
the SoC. The vendor watchdog driver (cnc18xx_wdt.c) accesses the
DesignWare watchdog at 0x801e1000 with 32 bit cycles; describe it for
dw_wdt, which gives /dev/watchdog and the restart handler. 32 bit reads
return 0 in the upper half, which only shortens what get_timeleft sees.

There is no power-off control in the vendor BSP, so poweroff stays a
halt.
---
 arch/arm/boot/dts/celestial/cnc1800l.dtsi | 7 +++++++
 arch/arm/configs/cnc1800l_defconfig       | 2 ++
 2 files changed, 9 insertions(+)

diff --git a/arch/arm/boot/dts/celestial/cnc1800l.dtsi b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
index c564bbfaf..848001248 100644
--- a/arch/arm/boot/dts/celestial/cnc1800l.dtsi
+++ b/arch/arm/boot/dts/celestial/cnc1800l.dtsi
@@ -137,6 +137,13 @@ nand: nand-controller@a4000000 {
 			status = "disabled";
 		};
 
+		/* the vendor cnc18xx_wdt.c uses 32 bit accesses, TOP 15 = ~40s at PCLK */
+		watchdog@801e1000 {
+			compatible = "snps,dw-wdt";
+			reg = <0x801e1000 0x100>;
+			clocks = <&pclk>;
+		};
+
 		gpio: gpio@80260000 {
 			compatible = "celestial,cnc1800l-gpio";
 			reg = <0x80260000 0x100>;
diff --git a/arch/arm/configs/cnc1800l_defconfig b/arch/arm/configs/cnc1800l_defconfig
index 387d67a96..b17d3579b 100644
--- a/arch/arm/configs/cnc1800l_defconfig
+++ b/arch/arm/configs/cnc1800l_defconfig
@@ -38,6 +38,8 @@ CONFIG_MTD_UBI=y
 CONFIG_UBIFS_FS=y
 CONFIG_VFP=y
 CONFIG_GPIOLIB=y
+CONFIG_WATCHDOG=y
+CONFIG_DW_WATCHDOG=y
 CONFIG_RESET_CONTROLLER=y
 CONFIG_RESET_SIMPLE=y
 CONFIG_PINCTRL=y
