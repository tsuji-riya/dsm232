From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Sat, 21 Nov 2026 03:14:17 +0000
Subject: [PATCH 02/28] dt-bindings: arm: Add Celestial CNC1800L based boards

Add the CNC1800L SoC (ARM1176) and the D-Link DSM-232 media player
built on it.

Signed-off-by: Tsuji Riya <tsuji.riya@gmail.com>
---
 .../devicetree/bindings/arm/celestial.yaml    | 23 +++++++++++++++++++
 MAINTAINERS                                   |  6 +++++
 2 files changed, 29 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/celestial.yaml

diff --git a/Documentation/devicetree/bindings/arm/celestial.yaml b/Documentation/devicetree/bindings/arm/celestial.yaml
new file mode 100644
index 000000000..91495ef50
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/celestial.yaml
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/celestial.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L based boards
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+properties:
+  $nodename:
+    const: '/'
+  compatible:
+    items:
+      - enum:
+          - dlink,dsm-232-a1
+      - const: celestial,cnc1800l
+
+additionalProperties: true
+
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 8014b9f82..821dee0b9 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2750,6 +2750,12 @@ L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
 S:	Maintained
 F:	drivers/net/ethernet/cavium/thunder/
 
+ARM/CELESTIAL CNC1800L SOC SUPPORT
+M:	Tsuji Riya <tsuji.riya@gmail.com>
+L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
+S:	Maintained
+F:	Documentation/devicetree/bindings/arm/celestial.yaml
+
 ARM/CIRRUS LOGIC BK3 MACHINE SUPPORT
 M:	Lukasz Majewski <lukma@denx.de>
 L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
