From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Fri, 20 Nov 2026 06:20:01 +0000
Subject: [PATCH 13/13] ARM: dts: cnc1800l-dsm232: Wi-Fi MAC address from the
 U-Boot env

The vendor U-Boot env (SPI flash 0xc000, 8KiB with CRC32) holds the
D-Link Wi-Fi MAC address in "wifiaddr"; the vendor firmware gave it to
its ath6kl driver. Expose the env as an nvmem layout on its own
read-only partition and point the AR6003 SDIO function at the cell.
Without it the module's own address (AzureWave OUI) is used.
---
 .../boot/dts/celestial/cnc1800l-dsm232.dts    | 35 +++++++++++++++++--
 arch/arm/configs/cnc1800l_defconfig           |  1 +
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
index 5662e9638..5f708b81d 100644
--- a/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
+++ b/arch/arm/boot/dts/celestial/cnc1800l-dsm232.dts
@@ -84,6 +84,15 @@ &mmc {
 	cap-sd-highspeed;
 	max-frequency = <25000000>;	/* guess (推測): SDIO high speed limit */
 	mmc-pwrseq = <&wifi_pwrseq>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/* AR6003, with the Wi-Fi MAC address the vendor firmware uses */
+	wifi@1 {
+		reg = <1>;
+		nvmem-cells = <&wifiaddr 0>;
+		nvmem-cell-names = "mac-address";
+	};
 };
 
 &uart0 {
@@ -112,13 +121,35 @@ partitions {
 			#size-cells = <1>;
 
 			/*
-			 * Miniloader + U-Boot env (0xc000) and a second copy at
+			 * Miniloader, U-Boot env and a second copy of both at
 			 * 0x10000, as dumped. Boot-critical: read-only, and only
 			 * this range is exposed.
 			 */
 			partition@0 {
 				label = "miniloader";
-				reg = <0x00000000 0x00020000>;
+				reg = <0x00000000 0x0000c000>;
+				read-only;
+			};
+
+			partition@c000 {
+				label = "u-boot-env";
+				reg = <0x0000c000 0x00004000>;
+				read-only;
+
+				/* 8KiB env (CRC32 checked), then erased flash */
+				nvmem-layout {
+					compatible = "u-boot,env";
+					env-size = <0x2000>;
+
+					wifiaddr: wifiaddr {
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@10000 {
+				label = "miniloader-copy";
+				reg = <0x00010000 0x00010000>;
 				read-only;
 			};
 		};
diff --git a/arch/arm/configs/cnc1800l_defconfig b/arch/arm/configs/cnc1800l_defconfig
index 598e204e3..79c50f973 100644
--- a/arch/arm/configs/cnc1800l_defconfig
+++ b/arch/arm/configs/cnc1800l_defconfig
@@ -31,6 +31,7 @@ CONFIG_MTD_RAW_NAND=y
 CONFIG_MTD_NAND_CNC1800L=y
 CONFIG_MTD_NAND_ECC_SW_BCH=y
 CONFIG_MTD_SPI_NOR=y
+CONFIG_NVMEM_LAYOUT_U_BOOT_ENV=y
 CONFIG_SPI=y
 CONFIG_SPI_DESIGNWARE=y
 CONFIG_SPI_DW_MMIO=y
