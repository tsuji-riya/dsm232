diff --git a/drivers/clk/clk-cnc1800l.c b/drivers/clk/clk-cnc1800l.c
new file mode 100644
index 000000000..77b21b6ec
--- /dev/null
+++ b/drivers/clk/clk-cnc1800l.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Celestial (Cavium) CNC1800L clocks: the display PLL (TVE PLL) with the
+ * display and HDMI TMDS dividers, and the clock enables the drivers use.
+ * The other clocks are left as the boot loader set them up and are
+ * described as fixed clocks. Register use of the vendor
+ * cnc1800l_power_clk.c.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include <dt-bindings/clock/celestial,cnc1800l-clk.h>
+
+/* first register range, at 0xb2100000 */
+#define PLL_TVE_DIV	0x108
+#define  TVE_DIV_EN	BIT(15)
+#define PLL_CLK_EN	0x140
+#define TVE_DIV_N	0x148
+/* second register range, at 0xb210020c */
+#define PLL_SLEEP_N	0x00
+#define USB_ULPI_BYPASS	0x0c
+
+static DEFINE_SPINLOCK(cnc_clk_lock);
+
+struct cnc_pll {
+	struct clk_hw hw;
+	void __iomem *base, *sleep;
+};
+
+#define to_cnc_pll(_hw) container_of(_hw, struct cnc_pll, hw)
+
+/* PLL settings of the vendor disp_pll_cfg[] table: 27MHz * (fb + 1) / m */
+static const struct { u8 m, fb; } cnc_pll_cfg[] = {
+	{ 4, 15 },	/* 108MHz: 27MHz SD modes, / 4 */
+	{ 2, 21 },	/* 297MHz: 148.5 and 74.25MHz HD modes, / 2 and / 4 */
+	{ 15, 27 },	/* 50.4MHz: 640x480 (25.2MHz), / 2 */
+	{ 5, 23 },	/* 129.6MHz: 1024x768 (64.8MHz), / 2 */
+	{ 2, 15 },	/* 216MHz: 1280x1024 (108MHz), / 2 */
+};
+
+static unsigned long cnc_pll_rate(unsigned long parent, unsigned int m, unsigned int fb)
+{
+	return m ? parent / m * (fb + 1) : 0;
+}
+
+static unsigned long cnc_pll_recalc_rate(struct clk_hw *hw, unsigned long parent)
+{
+	u32 v = readl(to_cnc_pll(hw)->base + PLL_TVE_DIV);
+
+	return cnc_pll_rate(parent, v & 0xff, (v >> 8) & 0x7f);
+}
+
+static int cnc_pll_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	unsigned long best = 0, rate;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cnc_pll_cfg); i++) {
+		rate = cnc_pll_rate(req->best_parent_rate, cnc_pll_cfg[i].m, cnc_pll_cfg[i].fb);
+		if (abs_diff(rate, req->rate) < abs_diff(best, req->rate))
+			best = rate;
+	}
+	req->rate = best;
+	return 0;
+}
+
+static int cnc_pll_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct cnc_pll *pll = to_cnc_pll(hw);
+	unsigned long flags;
+	unsigned int i;
+	u32 v;
+
+	for (i = 0; i < ARRAY_SIZE(cnc_pll_cfg); i++)
+		if (cnc_pll_rate(parent, cnc_pll_cfg[i].m, cnc_pll_cfg[i].fb) == rate)
+			break;
+	if (i == ARRAY_SIZE(cnc_pll_cfg))
+		return -EINVAL;
+
+	/* clock_disptve_pllmode(): sleep (bit 1, then 0), program, wake (bit 0, then 1) */
+	spin_lock_irqsave(&cnc_clk_lock, flags);
+	writel(readl(pll->sleep) & ~BIT(1), pll->sleep);
+	udelay(10);
+	writel(readl(pll->sleep) & ~BIT(0), pll->sleep);
+	v = readl(pll->base + PLL_TVE_DIV) & ~0xffff;
+	writel(v | TVE_DIV_EN | cnc_pll_cfg[i].fb << 8 | cnc_pll_cfg[i].m, pll->base + PLL_TVE_DIV);
+	spin_unlock_irqrestore(&cnc_clk_lock, flags);
+	usleep_range(500, 1000);
+	spin_lock_irqsave(&cnc_clk_lock, flags);
+	writel(readl(pll->sleep) | BIT(0), pll->sleep);
+	udelay(100);
+	writel(readl(pll->sleep) | BIT(1), pll->sleep);
+	spin_unlock_irqrestore(&cnc_clk_lock, flags);
+	return 0;
+}
+
+static const struct clk_ops cnc_pll_ops = {
+	.recalc_rate	= cnc_pll_recalc_rate,
+	.determine_rate	= cnc_pll_determine_rate,
+	.set_rate	= cnc_pll_set_rate,
+};
+
+static int cnc_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_hw_onecell_data *data;
+	struct clk_init_data init = {};
+	const char *osc;
+	void __iomem *base, *sleep;
+	struct cnc_pll *pll;
+	struct clk_hw **hws;
+	int ret;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	sleep = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(sleep))
+		return PTR_ERR(sleep);
+
+	data = devm_kzalloc(dev, struct_size(data, hws, CNC1800L_NR_CLKS), GFP_KERNEL);
+	pll = devm_kzalloc(dev, sizeof(*pll), GFP_KERNEL);
+	if (!data || !pll)
+		return -ENOMEM;
+	data->num = CNC1800L_NR_CLKS;
+	hws = data->hws;
+
+	/*
+	 * shortcut: every clock output enabled as the vendor SDIO probe does
+	 * (which one the SDIO host needs is not known); gate them one by one
+	 * once the enables are understood.
+	 */
+	writel(~0, base + PLL_CLK_EN);
+
+	osc = of_clk_get_parent_name(dev->of_node, 0);
+	pll->base = base;
+	pll->sleep = sleep;
+	init.name = "tve_pll";
+	init.ops = &cnc_pll_ops;
+	init.parent_names = &osc;
+	init.num_parents = 1;
+	pll->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &pll->hw);
+	if (ret)
+		return ret;
+	hws[CNC1800L_CLK_TVE_PLL] = &pll->hw;
+
+	hws[CNC1800L_CLK_DISP0] =
+		devm_clk_hw_register_divider(dev, "disp0_div", "tve_pll", CLK_SET_RATE_PARENT,
+					     base + TVE_DIV_N, 8, 4, CLK_DIVIDER_ONE_BASED,
+					     &cnc_clk_lock);
+	hws[CNC1800L_CLK_HDMI_TMDS] =
+		devm_clk_hw_register_divider(dev, "tmds_div", "tve_pll", CLK_SET_RATE_PARENT,
+					     base + TVE_DIV_N, 12, 4, CLK_DIVIDER_ONE_BASED,
+					     &cnc_clk_lock);
+	if (IS_ERR(hws[CNC1800L_CLK_DISP0]) || IS_ERR(hws[CNC1800L_CLK_HDMI_TMDS]))
+		return -EINVAL;
+	/* left running for the picture the boot loader may show until the display driver */
+	hws[CNC1800L_CLK_DISP0] =
+		devm_clk_hw_register_gate(dev, "disp0", "disp0_div",
+					  CLK_SET_RATE_PARENT | CLK_IGNORE_UNUSED,
+					  base + PLL_CLK_EN, 4, 0, &cnc_clk_lock);
+	hws[CNC1800L_CLK_HDMI_TMDS] =
+		devm_clk_hw_register_gate(dev, "hdmi_tmds", "tmds_div",
+					  CLK_SET_RATE_PARENT | CLK_IGNORE_UNUSED,
+					  base + PLL_CLK_EN, 6, 0, &cnc_clk_lock);
+	hws[CNC1800L_CLK_AUDIO] =
+		devm_clk_hw_register_gate(dev, "audio", NULL, 0, base + PLL_CLK_EN, 22, 0,
+					  &cnc_clk_lock);
+	hws[CNC1800L_CLK_CEC] =
+		devm_clk_hw_register_gate(dev, "cec", NULL, 0, base + PLL_CLK_EN, 26, 0,
+					  &cnc_clk_lock);
+	/* ULPI bypass bits 0-1, "enable and 48MHz" for the USB PHY */
+	hws[CNC1800L_CLK_USB_PHY] =
+		devm_clk_hw_register_gate(dev, "usb_phy", NULL, 0, sleep + USB_ULPI_BYPASS, 1, 0,
+					  &cnc_clk_lock);
+	hws[CNC1800L_CLK_USB] =
+		devm_clk_hw_register_gate(dev, "usb", "usb_phy", 0, sleep + USB_ULPI_BYPASS, 0, 0,
+					  &cnc_clk_lock);
+
+	for (ret = 0; ret < CNC1800L_NR_CLKS; ret++)
+		if (IS_ERR(hws[ret]))
+			return PTR_ERR(hws[ret]);
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+}
+
+static const struct of_device_id cnc_clk_of_match[] = {
+	{ .compatible = "celestial,cnc1800l-clk" },
+	{ }
+};
+
+static struct platform_driver cnc_clk_driver = {
+	.probe	= cnc_clk_probe,
+	.driver	= {
+		.name		= "cnc1800l-clk",
+		.of_match_table	= cnc_clk_of_match,
+	},
+};
+builtin_platform_driver(cnc_clk_driver);
