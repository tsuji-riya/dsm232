From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Sat, 21 Nov 2026 03:14:20 +0000
Subject: [PATCH 12/28] dt-bindings: mtd: Add Celestial CNC1800L NAND
 controller

The CNC1800L NAND controller has a 1-bit Hamming ECC engine; the ECC
scheme is chosen with the standard NAND properties of the chip node.

Signed-off-by: Tsuji Riya <tsuji.riya@gmail.com>
---
 .../bindings/mtd/celestial,cnc1800l-nand.yaml | 49 +++++++++++++++++++
 MAINTAINERS                                   |  2 +
 2 files changed, 51 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mtd/celestial,cnc1800l-nand.yaml

diff --git a/Documentation/devicetree/bindings/mtd/celestial,cnc1800l-nand.yaml b/Documentation/devicetree/bindings/mtd/celestial,cnc1800l-nand.yaml
new file mode 100644
index 000000000..5292eeea1
--- /dev/null
+++ b/Documentation/devicetree/bindings/mtd/celestial,cnc1800l-nand.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mtd/celestial,cnc1800l-nand.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial CNC1800L NAND controller
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+description: |
+  NAND controller of the Celestial (Cavium) CNC1800L SoC. The default ECC
+  is the SoC 1-bit Hamming engine (3 bytes per 512 bytes), which matches
+  the vendor firmware on-flash format. Generic software ECC can be selected
+  with the standard nand-ecc-* properties of the NAND chip child node
+  (not compatible with existing vendor formatted flash).
+
+allOf:
+  - $ref: nand-controller.yaml
+
+properties:
+  compatible:
+    const: celestial,cnc1800l-nand
+
+  reg:
+    items:
+      - description: NAND access window.
+      - description: Controller registers.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    nand-controller@a4000000 {
+        compatible = "celestial,cnc1800l-nand";
+        reg = <0xa4000000 0x2000000>, <0x80100000 0x48>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        nand@0 {
+            reg = <0>;
+            nand-on-flash-bbt;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
