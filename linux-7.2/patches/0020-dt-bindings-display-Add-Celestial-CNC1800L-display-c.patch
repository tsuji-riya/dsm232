From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tsuji Riya <tsuji.riya@gmail.com>
Date: Sat, 21 Nov 2026 03:14:22 +0000
Subject: [PATCH 20/28] dt-bindings: display: Add Celestial CNC1800L display
 controller

The CNC1800L display feeder drives an on-chip Silicon Image HDMI
transmitter with a CEC controller.

Signed-off-by: Tsuji Riya <tsuji.riya@gmail.com>
---
 .../display/celestial,cnc1800l-display.yaml   | 67 +++++++++++++++++++
 MAINTAINERS                                   |  2 +
 2 files changed, 69 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/celestial,cnc1800l-display.yaml

diff --git a/Documentation/devicetree/bindings/display/celestial,cnc1800l-display.yaml b/Documentation/devicetree/bindings/display/celestial,cnc1800l-display.yaml
new file mode 100644
index 000000000..11c8d5339
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/celestial,cnc1800l-display.yaml
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/celestial,cnc1800l-display.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Celestial (Cavium) CNC1800L display feeder and HDMI transmitter
+
+maintainers:
+  - Tsuji Riya <tsuji.riya@gmail.com>
+
+properties:
+  compatible:
+    const: celestial,cnc1800l-display
+
+  reg:
+    items:
+      - description: display feeder
+      - description: HDMI transmitter, with the CEC controller at +0x1000
+
+  reg-names:
+    items:
+      - const: df
+      - const: hdmi
+
+  clocks:
+    items:
+      - description: display (pixel) clock
+      - description: HDMI TMDS clock
+      - description: CEC controller clock
+
+  clock-names:
+    items:
+      - const: disp
+      - const: tmds
+      - const: cec
+
+  resets:
+    maxItems: 2
+
+  reset-names:
+    items:
+      - const: disp
+      - const: hdmi
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    display@b1800000 {
+        compatible = "celestial,cnc1800l-display";
+        reg = <0xb1800000 0x1000>, <0x80400000 0x2000>;
+        reg-names = "df", "hdmi";
+        clocks = <&clk 1>, <&clk 2>, <&clk 4>;
+        clock-names = "disp", "tmds", "cec";
+        resets = <&rst 13>, <&rst 19>;
+        reset-names = "disp", "hdmi";
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index f13e4e888..d37e38469 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2760,12 +2760,14 @@ F:	drivers/net/ethernet/cavium/thunder/
 
 
 
