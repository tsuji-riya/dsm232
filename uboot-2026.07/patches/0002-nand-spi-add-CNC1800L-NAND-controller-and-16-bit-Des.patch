diff --git a/drivers/mtd/nand/raw/cnc1800l_nand.c b/drivers/mtd/nand/raw/cnc1800l_nand.c
new file mode 100644
index 00000000..f546f74b
--- /dev/null
+++ b/drivers/mtd/nand/raw/cnc1800l_nand.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NAND controller driver for the Celestial (Cavium) CNC1800L SoC
+ *
+ * Data cycles go to the base of the access window, command / address cycles
+ * to base + CLE / ALE. Chip enable is forced from CEn_CFG_0, ready/busy is
+ * read from the status register.
+ *
+ * ECC follows the standard NAND device tree properties of the chip node
+ * (same as Linux):
+ *  - default ("legacy"): SoC 1-bit Hamming engine, 3 bytes per 512 bytes,
+ *    the vendor on-flash format (used by the miniloader / vendor firmware)
+ *  - nand-ecc-mode = "soft" (+ nand-ecc-algo = "bch", nand-ecc-strength,
+ *    nand-ecc-step-size): generic software ECC, NOT compatible with the
+ *    vendor format.
+ */
+
+#include <dm.h>
+#include <log.h>
+#include <malloc.h>
+#include <nand.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/mtd/rawnand.h>
+
+#define CNC_CE_CFG0(cs)		((cs) * 0x0c)
+#define CNC_CE_FORCE_LOW	BIT(9)
+#define CNC_STATUS		0x30
+#define CNC_STATUS_READY	BIT(0)
+#define CNC_ECC_CODE		0x40
+#define CNC_ECC_ADDR		0x48
+
+#define CNC_MASK_ALE		0x08
+#define CNC_MASK_CLE		0x04
+
+struct cnc_nand {
+	struct nand_chip	chip;
+	void __iomem		*base;	/* control registers */
+	void __iomem		*window; /* data window (identity mapped) */
+};
+
+static inline struct cnc_nand *to_cnc_nand(struct mtd_info *mtd)
+{
+	return container_of(mtd_to_nand(mtd), struct cnc_nand, chip);
+}
+
+/* ---- legacy 1-bit Hamming engine (vendor format) ---- */
+
+static void cnc_nand_hwctl(struct mtd_info *mtd, int mode)
+{
+	struct cnc_nand *nand = to_cnc_nand(mtd);
+
+	/* the engine snoops the data window access at this address */
+	writel((u32)(uintptr_t)nand->window, nand->base + CNC_ECC_ADDR);
+}
+
+static int cnc_nand_calculate(struct mtd_info *mtd, const u_char *dat,
+			      u_char *ecc_code)
+{
+	struct cnc_nand *nand = to_cnc_nand(mtd);
+	u32 ecc24 = readl(nand->base + CNC_ECC_CODE);
+
+	ecc_code[0] = ecc24;
+	ecc_code[1] = ecc24 >> 8;
+	ecc_code[2] = ecc24 >> 16;
+
+	return 0;
+}
+
+static int cnc_nand_correct(struct mtd_info *mtd, u_char *dat,
+			    u_char *read_ecc, u_char *calc_ecc)
+{
+	u32 ecc_nand = read_ecc[0] | (read_ecc[1] << 8) | (read_ecc[2] << 16);
+	u32 ecc_calc = calc_ecc[0] | (calc_ecc[1] << 8) | (calc_ecc[2] << 16);
+	u32 diff = ecc_calc ^ ecc_nand;
+	unsigned int bit, byte;
+
+	if (!diff)
+		return 0;
+
+	if ((((diff >> 1) ^ diff) & 0x555555) == 0x555555) {
+		bit = ((diff >> 19) & 1) | ((diff >> 20) & 2) |
+		      ((diff >> 21) & 4);
+		byte = ((diff >> 9) & 0x100) | (diff & 0x80) |
+		       ((diff << 1) & 0x40) | ((diff << 2) & 0x20) |
+		       ((diff << 3) & 0x10) | ((diff >> 12) & 0x08) |
+		       ((diff >> 11) & 0x04) | ((diff >> 10) & 0x02) |
+		       ((diff >> 9) & 0x01);
+
+		if (byte >= 512)
+			return -EBADMSG;
+		dat[byte] ^= BIT(bit);
+		return 1;
+	}
+
+	/* single bit error in the code itself */
+	if (!(diff & (diff - 1)))
+		return 1;
+
+	return -EBADMSG;
+}
+
+/* ---- bus access ---- */
+
+static void cnc_nand_cmd_ctrl(struct mtd_info *mtd, int cmd, unsigned int ctrl)
+{
+	struct cnc_nand *nand = to_cnc_nand(mtd);
+	struct nand_chip *chip = &nand->chip;
+	void __iomem *addr = nand->window;
+	u32 val;
+
+	if (ctrl & NAND_CTRL_CHANGE) {
+		val = readl(nand->base + CNC_CE_CFG0(0));
+		if (ctrl & NAND_NCE)
+			val |= CNC_CE_FORCE_LOW;
+		else
+			val &= ~CNC_CE_FORCE_LOW;
+		writel(val, nand->base + CNC_CE_CFG0(0));
+
+		if (ctrl & NAND_CLE)
+			addr += CNC_MASK_CLE;
+		else if (ctrl & NAND_ALE)
+			addr += CNC_MASK_ALE;
+		chip->IO_ADDR_W = addr;
+	}
+
+	if (cmd != NAND_CMD_NONE)
+		writeb(cmd, chip->IO_ADDR_W);
+}
+
+static int cnc_nand_dev_ready(struct mtd_info *mtd)
+{
+	struct cnc_nand *nand = to_cnc_nand(mtd);
+
+	return readl(nand->base + CNC_STATUS) & CNC_STATUS_READY;
+}
+
+static void cnc_nand_read_buf(struct mtd_info *mtd, u_char *buf, int len)
+{
+	struct nand_chip *chip = mtd_to_nand(mtd);
+
+	readsb(chip->IO_ADDR_R, buf, len);
+}
+
+static void cnc_nand_write_buf(struct mtd_info *mtd, const u_char *buf, int len)
+{
+	struct nand_chip *chip = mtd_to_nand(mtd);
+
+	writesb(chip->IO_ADDR_W, buf, len);
+}
+
+static int cnc_nand_probe(struct udevice *dev)
+{
+	struct cnc_nand *nand = dev_get_priv(dev);
+	struct nand_chip *chip = &nand->chip;
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	ofnode node = dev_ofnode(dev);
+	fdt_addr_t addr;
+	int ret;
+
+	addr = dev_read_addr_index(dev, 0);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+	nand->window = (void __iomem *)addr;
+
+	addr = dev_read_addr_index(dev, 1);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+	nand->base = (void __iomem *)addr;
+
+	/* ECC properties live on the first chip child node (as in Linux) */
+	if (ofnode_valid(ofnode_first_subnode(node)))
+		node = ofnode_first_subnode(node);
+	nand_set_flash_node(chip, node);
+
+	chip->IO_ADDR_R = nand->window;
+	chip->IO_ADDR_W = nand->window;
+	chip->chip_delay = 0;
+	chip->cmd_ctrl = cnc_nand_cmd_ctrl;
+	chip->dev_ready = cnc_nand_dev_ready;
+	chip->read_buf = cnc_nand_read_buf;
+	chip->write_buf = cnc_nand_write_buf;
+	chip->bbt_options |= NAND_BBT_USE_FLASH;
+
+	/* legacy default; nand_scan() may replace it from the DT properties */
+	chip->ecc.mode = NAND_ECC_HW;
+	chip->ecc.size = 512;
+	chip->ecc.bytes = 3;
+	chip->ecc.strength = 1;
+	chip->ecc.algo = NAND_ECC_HAMMING;
+	chip->ecc.calculate = cnc_nand_calculate;
+	chip->ecc.correct = cnc_nand_correct;
+	chip->ecc.hwctl = cnc_nand_hwctl;
+
+	ret = nand_scan(mtd, 1);
+	if (ret)
+		return ret;
+
+	return nand_register(0, mtd);
+}
+
+static const struct udevice_id cnc_nand_ids[] = {
+	{ .compatible = "celestial,cnc1800l-nand" },
+	{ }
+};
+
+U_BOOT_DRIVER(cnc1800l_nand) = {
+	.name		= "cnc1800l-nand",
+	.id		= UCLASS_MTD,
+	.of_match	= cnc_nand_ids,
+	.probe		= cnc_nand_probe,
+	.priv_auto	= sizeof(struct cnc_nand),
+};
+
+void board_nand_init(void)
+{
+	struct udevice *dev;
+	int ret;
+
+	ret = uclass_get_device_by_driver(UCLASS_MTD,
+					  DM_DRIVER_GET(cnc1800l_nand), &dev);
+	if (ret && ret != -ENODEV)
+		pr_err("Failed to initialize CNC1800L NAND: %d\n", ret);
+}
diff --git a/drivers/spi/designware_spi.c b/drivers/spi/designware_spi.c
index b520c727..b2e48fb7 100644
--- a/drivers/spi/designware_spi.c
+++ b/drivers/spi/designware_spi.c
@@ -118,6 +118,7 @@
 struct dw_spi_plat {
 	s32 frequency;		/* Default clock frequency, -1 for none */
 	void __iomem *regs;
+	u32 reg_io_width;	/* register access width in bytes (2 or 4) */
 };
 
 struct dw_spi_priv {
@@ -128,6 +129,7 @@ struct dw_spi_priv {
 	u32 (*update_cr0)(struct dw_spi_priv *priv);
 
 	void __iomem *regs;
+	u32 reg_io_width;
 	unsigned long bus_clk_rate;
 	unsigned int freq;		/* Default frequency */
 	unsigned int mode;
@@ -148,12 +150,33 @@ struct dw_spi_priv {
 
 static inline u32 dw_read(struct dw_spi_priv *priv, u32 offset)
 {
+	if (priv->reg_io_width == 2)
+		return __raw_readw(priv->regs + offset);
+
 	return __raw_readl(priv->regs + offset);
 }
 
 static inline void dw_write(struct dw_spi_priv *priv, u32 offset, u32 val)
 {
-	__raw_writel(val, priv->regs + offset);
+	if (priv->reg_io_width == 2)
+		__raw_writew(val, priv->regs + offset);
+	else
+		__raw_writel(val, priv->regs + offset);
+}
+
+/* Wait until the Tx FIFO is empty and the controller is idle */
+static int dw_spi_wait_idle(struct dw_spi_priv *priv)
+{
+	unsigned long start = get_timer(0);
+	u32 val;
+
+	do {
+		val = dw_read(priv, DW_SPI_SR);
+		if ((val & SR_TF_EMPT) && !(val & SR_BUSY))
+			return 0;
+	} while (get_timer(start) < RX_TIMEOUT);
+
+	return -ETIMEDOUT;
 }
 
 static u32 dw_spi_dw16_update_cr0(struct dw_spi_priv *priv)
@@ -252,6 +275,10 @@ static int dw_spi_of_to_plat(struct udevice *bus)
 	if (!plat->regs)
 		return -EINVAL;
 
+	plat->reg_io_width = dev_read_u32_default(bus, "reg-io-width", 4);
+	if (plat->reg_io_width != 2 && plat->reg_io_width != 4)
+		return -EINVAL;
+
 	/* Use 500KHz as a suitable default */
 	plat->frequency = dev_read_u32_default(bus, "spi-max-frequency",
 					       500000);
@@ -363,6 +390,7 @@ static int dw_spi_probe(struct udevice *bus)
 	u32 version;
 
 	priv->regs = plat->regs;
+	priv->reg_io_width = plat->reg_io_width;
 	priv->freq = plat->frequency;
 
 	ret = dw_spi_get_clk(bus, &priv->bus_clk_rate);
@@ -501,7 +529,6 @@ static int dw_spi_xfer(struct udevice *dev, unsigned int bitlen,
 	u8 *rx = din;
 	int ret = 0;
 	u32 cr0 = 0;
-	u32 val;
 	u32 cs;
 
 	/* spi core configured to do 8 bit transfers */
@@ -564,11 +591,8 @@ static int dw_spi_xfer(struct udevice *dev, unsigned int bitlen,
 	 * which happens when writing 0 to DW_SPI_SSIENR which happens
 	 * in the beginning of new transfer.
 	 */
-	if (readl_poll_timeout(priv->regs + DW_SPI_SR, val,
-			       (val & SR_TF_EMPT) && !(val & SR_BUSY),
