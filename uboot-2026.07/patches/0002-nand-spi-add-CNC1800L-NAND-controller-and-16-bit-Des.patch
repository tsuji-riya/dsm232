--- /dev/null
+++ b/arch/arm/dts/cnc1800l-dsm232-newecc.dts
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * DSM-232 with the generic software BCH NAND ECC instead of the SoC 1-bit
+ * Hamming engine. NOT compatible with the vendor on-flash format
+ * (miniloader, vendor firmware).
+ */
+#include "cnc1800l-dsm232.dts"
+
+/ {
+	model = "D-Link DSM-232 (A1), generic NAND ECC";
+};
+
+&nand {
+	nand@0 {
+		nand-ecc-mode = "soft";
+		nand-ecc-algo = "bch";
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+	};
+};
