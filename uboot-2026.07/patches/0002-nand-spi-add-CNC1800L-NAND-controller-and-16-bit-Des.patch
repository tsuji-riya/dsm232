+	/* AHB2_SPI_TCLK of the SPI controller */
+	spi_clk: clock-spi {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <94500000>;
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
@@ -47,6 +54,41 @@
 			bootph-all;
 		};
 
+		/* Designware SSI with 16 bit register accesses */
+		spi0: spi@80150000 {
+			compatible = "snps,dw-apb-ssi";
+			reg = <0x80150000 0x100>;
+			reg-io-width = <2>;
+			clocks = <&spi_clk>;
+			spi-max-frequency = <40000000>;
+			num-cs = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <40000000>;
+			};
+		};
+
+		nand: nand-controller@a4000000 {
+			compatible = "celestial,cnc1800l-nand";
+			reg = <0xa4000000 0x2000000>, <0x80100000 0x48>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			nand@0 {
+				reg = <0>;
+				nand-on-flash-bbt;
+
+				/*
+				 * LEGACY ECC (default): SoC 1-bit Hamming /
+				 * 512 bytes, the vendor on-flash format.
+				 */
+			};
+		};
+
 		uart0: serial@801f1000 {
 			compatible = "snps,dw-apb-uart";
 			reg = <0x801f1000 0x100>;
