--- /dev/null
+++ b/drivers/timer/cnc1800l-timer.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Celestial CNC1800L APB timer: free running 32 bit down counter.
+ * The registers are accessed with 16 bit bus cycles (as the vendor BSP does).
+ */
+
+#include <dm.h>
+#include <timer.h>
+#include <asm/io.h>
+
+#define CNC_LOADCOUNT		0x00
+#define CNC_CURRENT		0x04
+#define CNC_CTRL		0x08
+#define CNC_CTRL_ENABLE		BIT(0)
+#define CNC_CTRL_PERIODIC	BIT(1)
+#define CNC_CTRL_INTMASK	BIT(2)
+
+struct cnc1800l_timer_priv {
+	void __iomem *regs;
+};
+
+static u64 cnc1800l_timer_get_count(struct udevice *dev)
+{
+	struct cnc1800l_timer_priv *priv = dev_get_priv(dev);
+	u16 hi, lo, hi2;
+
+	hi = readw(priv->regs + CNC_CURRENT + 2);
+	lo = readw(priv->regs + CNC_CURRENT);
+	hi2 = readw(priv->regs + CNC_CURRENT + 2);
+	if (hi2 != hi)
+		lo = readw(priv->regs + CNC_CURRENT);
+
+	/* The counter counts down, the uclass wants an increasing count. */
+	return timer_conv_64(~(((u32)hi2 << 16) | lo));
+}
+
+static int cnc1800l_timer_probe(struct udevice *dev)
+{
+	struct timer_dev_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct cnc1800l_timer_priv *priv = dev_get_priv(dev);
+
+	priv->regs = dev_read_addr_ptr(dev);
+	if (!priv->regs)
+		return -EINVAL;
+
+	uc_priv->clock_rate = dev_read_u32_default(dev, "clock-frequency",
+						   47250000);
+
+	writel(0, priv->regs + CNC_CTRL);
+	writew(0xffff, priv->regs + CNC_LOADCOUNT);
+	writew(0xffff, priv->regs + CNC_LOADCOUNT + 2);
+	writel(CNC_CTRL_INTMASK, priv->regs + CNC_CTRL);
+	writel(CNC_CTRL_INTMASK | CNC_CTRL_PERIODIC | CNC_CTRL_ENABLE,
+	       priv->regs + CNC_CTRL);
+
+	return 0;
+}
+
+static const struct timer_ops cnc1800l_timer_ops = {
+	.get_count = cnc1800l_timer_get_count,
+};
+
+static const struct udevice_id cnc1800l_timer_ids[] = {
+	{ .compatible = "celestial,cnc1800l-apb-timer" },
+	{ }
+};
+
+U_BOOT_DRIVER(cnc1800l_timer) = {
+	.name		= "cnc1800l_timer",
+	.id		= UCLASS_TIMER,
+	.of_match	= cnc1800l_timer_ids,
+	.probe		= cnc1800l_timer_probe,
+	.ops		= &cnc1800l_timer_ops,
+	.priv_auto	= sizeof(struct cnc1800l_timer_priv),
+};
