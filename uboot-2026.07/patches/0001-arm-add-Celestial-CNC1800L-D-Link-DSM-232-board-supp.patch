index 00000000..4156813f
--- /dev/null
+++ b/arch/arm/dts/cnc1800l-dsm232.dts
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/dts-v1/;
+
+/ {
+	model = "D-Link DSM-232 (A1)";
+	compatible = "dlink,dsm-232-a1", "celestial,cnc1800l";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootph-all;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,arm1176jzf-s";
+			reg = <0>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x10000000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		bootph-all;
+
+		timer@801e2000 {
+			compatible = "celestial,cnc1800l-apb-timer";
+			reg = <0x801e2000 0x100>;
+			clock-frequency = <47250000>;
+			bootph-all;
+		};
+
+		uart0: serial@801f1000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x801f1000 0x100>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clock-frequency = <47250000>;
+			bootph-all;
+		};
+
+		uart1: serial@801f2000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0x801f2000 0x100>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clock-frequency = <47250000>;
+			status = "disabled";
+		};
+	};
+};
