@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * D-Link DSM-232 (Celestial CNC1800L)
+ */
+
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/*
+ * The vendor firmware uses the top of the 256 MiB DRAM for the framebuffers,
+ * video/audio buffers, ethernet, crypto and demux (see Linux mem_define.h).
+ * Keep U-Boot (and its relocation) below that area.
+ */
+#define DSM232_USABLE_RAM_TOP	0x08900000
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	return DSM232_USABLE_RAM_TOP;
+}
+
+int board_init(void)
+{
+	return 0;
+}
+
+/* DDR, PLLs and pin muxing are already set up by the vendor miniloader. */
+void lowlevel_init(void)
+{
+}
+
+#define CNC1800L_WDT_BASE	0x801e1000
+#define WDT_CR			0x00
+#define WDT_TORR		0x04
+#define WDT_CCVR		0x08
+
+/* Reset the SoC with the watchdog, using 16 bit accesses like the vendor code. */
+void reset_cpu(void)
+{
+	void __iomem *wdt = (void __iomem *)CNC1800L_WDT_BASE;
+
+	writew(0, wdt + WDT_TORR);
+	writew(0, wdt + WDT_TORR + 2);
+	writew(0, wdt + WDT_CCVR);
+	writew(0, wdt + WDT_CCVR + 2);
+	writew(1, wdt + WDT_CR);
+
+	while (1)
+		;
+}
